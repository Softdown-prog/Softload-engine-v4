<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE html>
<html b:css='false' b:defaultmessages='true' b:layoutsVersion='3' b:responsive='true' lang='pt-br' xmlns='http://www.w3.org/1999/xhtml' xmlns:b='http://www.google.com/2005/gml/b' xmlns:data='http://www.google.com/2005/gml/data' xmlns:expr='http://www.google.com/2005/gml/expr'>

<head>
  <b:include data='blog' name='all-head-content'/>
  <meta content='width=device-width, initial-scale=1.0' name='viewport'/>
  <title><data:blog.pageTitle/></title>

  <link href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css' rel='stylesheet'/>
  
  <link href='https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;700&amp;family=Space+Grotesk:wght@400;600;700&amp;display=swap' rel='stylesheet'/>

  <b:skin><![CDATA[
  
    /*
    <Group description="🎨 Cores do Tema (AppCraft)" selector=":root">
      <Variable name="cor.fundo" description="Cor de Fundo (Branco Gelo)" type="color" default="#f8f9fa" value="#f8f9fa"/>
      <Variable name="cor.escura" description="Cor Escura (Preto Nanquim)" type="color" default="#111111" value="#111111"/>
      <Variable name="cor.destaque" description="Cor de Destaque (Amarelo Tech)" type="color" default="#facc15" value="#facc15"/>
    </Group>
    */

    /*
    -----------------------------------------------
    Blogger Template Style
    Nome: AppCraft (Brutalista / Minimalista)
    ----------------------------------------------- */

    :root {
      --ac-bg: $(cor.fundo);
      --ac-dark: $(cor.escura);
      --ac-yellow: $(cor.destaque);
      
      --font-display: 'Space Grotesk', sans-serif;
      --font-mono: 'Fira Code', monospace;
    }

    /* === ESTILOS GLOBAIS === */
    body {
      background-color: var(--ac-bg);
      color: var(--ac-dark);
      font-family: var(--font-display);
      -webkit-font-smoothing: antialiased;
      line-height: 1.6;
    }

    /* Links Brutalistas (Sublinhado grosso que vira marca-texto) */
    a {
      color: var(--ac-dark);
      text-decoration: underline;
      text-decoration-thickness: 3px;
      text-decoration-color: var(--ac-yellow);
      text-underline-offset: 3px;
      transition: all 0.2s ease;
    }
    a:hover {
      background-color: var(--ac-yellow);
      color: var(--ac-dark);
      text-decoration: none;
    }

    h1, h2, h3, h4, h5, h6 { font-weight: 700; letter-spacing: -1px; color: var(--ac-dark); margin-bottom: 1rem; }

    /* === CABEÇALHO === */
    header {
      background-color: var(--ac-bg);
      border-bottom: 3px solid var(--ac-dark);
      padding: 0.5rem 0;
    }
    .navbar-brand h1 {
      font-weight: 700;
      font-size: 2rem;
      text-transform: uppercase;
      letter-spacing: -2px;
      margin: 0;
    }
    .navbar-brand { text-decoration: none; }
    .navbar-brand:hover { background-color: transparent; }
    
    .nav-link {
      font-weight: 700;
      text-transform: uppercase;
      font-size: 0.95rem;
      padding: 0.5rem 1.2rem !important;
      border: 2px solid transparent;
      text-decoration: none !important;
      color: var(--ac-dark) !important;
    }
    .nav-link:hover {
      background-color: var(--ac-yellow);
      border-color: var(--ac-dark);
    }
    .navbar-toggler { color: var(--ac-dark); border-radius: 0; padding: 5px; }
    .navbar-toggler:focus { box-shadow: 0 0 0 3px var(--ac-yellow); }

    /* === PÁGINA INICIAL ESTÁTICA === */
    .hero-section {
      border-bottom: 3px solid var(--ac-dark);
      padding: 6rem 0;
      /* Grid sutil de caderno pontilhado no fundo */
      background-image: radial-gradient(var(--ac-dark) 1px, transparent 1px);
      background-size: 30px 30px;
      background-position: center;
    }
    .hero-section h1, .hero-section h2 {
      font-size: clamp(3rem, 8vw, 5.5rem);
      line-height: 1;
      letter-spacing: -3px;
      font-weight: 700;
      background-color: var(--ac-bg); /* Limpa os pontos atrás do texto */
      display: inline-block;
      padding: 0 15px;
    }
    .hero-section p {
      font-size: 1.25rem;
      font-weight: 500;
      max-width: 600px;
      margin: 1.5rem auto;
      background-color: var(--ac-bg);
      padding: 10px;
    }

    .features-section { border-bottom: 3px solid var(--ac-dark); background: var(--ac-bg); }
    .features-section h2 { font-size: 2.5rem; text-transform: uppercase; border-bottom: 3px solid var(--ac-dark); display: inline-block; padding-bottom: 5px; margin-bottom: 2rem; }

    /* === FEED DE POSTS (ATUALIZAÇÕES) === */
    .post-feed .post-item { border-bottom: 3px solid var(--ac-dark); }
    .post-title { font-size: 2.2rem; line-height: 1.1; margin-bottom: 0.8rem; }
    .post-title a { text-decoration: none; }
    .post-title a:hover { background-color: var(--ac-yellow); }
    
    /* Metadados Estilo Código */
    .post-meta, .post-meta-single {
      font-family: var(--font-mono);
      font-size: 0.85rem;
      font-weight: 500;
      color: #444;
      text-transform: uppercase;
    }
    
    .post-snippet { font-size: 1.15rem; color: #222; margin-top: 1rem; }

    /* === SINGLE POST === */
    .post-title-single { font-size: clamp(2.5rem, 5vw, 4rem); line-height: 1; margin-bottom: 1rem; }
    .post-body-content { font-size: 1.2rem; line-height: 1.8; margin-top: 2rem; }
    .post-body-content img { max-width: 100%; height: auto; border: 3px solid var(--ac-dark); margin: 1.5rem 0; box-shadow: 8px 8px 0 var(--ac-dark); }
    
    /* Tags Brutalistas (Cruas) */
    .post-bottom-tags { font-family: var(--font-mono); font-weight: 500; font-size: 0.9rem; border-top: 3px solid var(--ac-dark); }
    .post-bottom-tags span:first-child { color: #666; }
    .post-bottom-tags a {
      background: var(--ac-dark);
      color: var(--ac-bg);
      text-decoration: none;
      padding: 2px 8px;
      display: inline-block;
      margin-top: 5px;
    }
    .post-bottom-tags a:hover {
      background: var(--ac-yellow);
      color: var(--ac-dark);
    }

    /* === SIDEBAR === */
    aside .widget {
      background: var(--ac-bg);
      border: 3px solid var(--ac-dark);
      padding: 1.5rem;
      box-shadow: 6px 6px 0 var(--ac-dark);
      margin-bottom: 2.5rem;
    }
    aside h3 {
      font-size: 1.3rem;
      text-transform: uppercase;
      border-bottom: 3px solid var(--ac-dark);
      padding-bottom: 10px;
      margin-bottom: 15px;
    }

    /* Paginação Clássica */
    .pagination a {
      font-family: var(--font-mono);
      font-weight: 700;
      text-decoration: none;
      border: 2px solid var(--ac-dark);
      padding: 8px 16px;
      text-transform: uppercase;
    }
    .pagination a:hover { background: var(--ac-dark); color: var(--ac-bg); }

    /* === FOOTER (CAIXA PRETA) === */
    .footer-section { background-color: var(--ac-dark); color: var(--ac-bg); border-top: 5px solid var(--ac-yellow); }
    .footer-section h2, .footer-section h3 { color: var(--ac-yellow); text-transform: uppercase; border-bottom: 2px solid #333; padding-bottom: 10px; }
    .footer-section a { color: var(--ac-bg); text-decoration-color: #555; }
    .footer-section a:hover { color: var(--ac-dark); background-color: var(--ac-yellow); text-decoration: none; }
    
    /* Contact Form Hacker UX */
    .contact-form-widget form { display: flex; flex-direction: column; gap: 15px; margin-top: 20px; }
    .contact-form-widget input, .contact-form-widget textarea {
      width: 100%;
      padding: 12px 15px;
      background: transparent;
      border: 2px solid #333;
      color: var(--ac-bg);
      font-family: var(--font-mono);
      font-size: 0.9rem;
      outline: none;
      border-radius: 0;
      transition: border-color 0.3s ease;
    }
    .contact-form-widget input::placeholder, .contact-form-widget textarea::placeholder { color: #666; }
    .contact-form-widget input:focus, .contact-form-widget textarea:focus { border-color: var(--ac-yellow); background: rgba(255, 255, 255, 0.05); }
    
    .contact-form-button-submit {
      background: var(--ac-yellow) !important;
      color: var(--ac-dark) !important;
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 1.1rem;
      border: none !important;
      padding: 12px !important;
      cursor: pointer;
      text-transform: uppercase;
      box-shadow: 4px 4px 0 #fff;
      transition: transform 0.1s, box-shadow 0.1s;
    }
    .contact-form-button-submit:hover { transform: translate(-2px, -2px); box-shadow: 6px 6px 0 #fff; }
    .contact-form-button-submit:active { transform: translate(4px, 4px); box-shadow: 0 0 0 #fff; } /* Efeito Tecla Mecânica */

    .footer-bottom { border-top: 1px solid #333 !important; font-family: var(--font-mono); font-size: 0.8rem; color: #888; }

blockquote{margin:30px 10px;padding:20px;background:var(--ac-primary);border:3px solid var(--ac-text);box-shadow:7px 7px 0 var(--ac-text);font-family:'Space Grotesk',sans-serif;font-weight:700;font-style:italic;color:var(--ac-text)}

  ]]></b:skin>
</head>

<body>

