{
  "validator-error-detection": {
    "objetivo-do-validador": {
      "meta-primaria": "identificar-e-corrigir-erros-estruturais-do-template-blogger-v3",
      "focos-de-reparo": [
        "xml-repair",
        "nesting-repair",
        "widget-repair",
        "escaping-repair",
        "parser-recovery"
      ]
    },
    "motor-deteccao-erros": {
      "erros-detectados": [
        {
          "tipo-de-erro": "xml-malformed-error",
          "regras-deteccao": [
            "missing-closing-tag",
            "invalid-character",
            "invalid-xml-structure"
          ]
        },
        {
          "tipo-de-erro": "widget-tree-error",
          "regras-deteccao": [
            "widget-outside-section",
            "invalid-widget-nesting",
            "missing-main-includable"
          ]
        },
        {
          "tipo-de-erro": "conditional-logic-error",
          "regras-deteccao": [
            "invalid-b-if-closure",
            "orphan-b-else",
            "invalid-loop-scope"
          ]
        },
        {
          "tipo-de-erro": "escaping-error",
          "regras-deteccao": [
            "invalid-ampersand",
            "unsafe-quotes",
            "broken-cdata"
          ]
        },
        {
          "tipo-de-erro": "render-error",
          "regras-deteccao": [
            "responsive-break",
            "layout-collapse",
            "duplicate-render-block"
          ]
        }
      ]
    }
  }
}
