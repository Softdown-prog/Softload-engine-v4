{
  "id": "ia-balcao-cabecalho-padrao-completo",
  "categoria": "padrao-estrutural",
  "conceito": "Padrão completo de cabeçalho Blogger com Bootstrap 5: ticker de notícias + navbar sticky + logo com ícone Bootstrap + menu via widget LinkList + grupo de ações (dark mode + busca). Cada peça tem posição e classe definidas para funcionar corretamente em mobile e desktop.",
  "estrutura_ticker": "<div class=\"ticker-bar py-2 border-bottom border-secondary\">\n  <div class=\"container d-flex align-items-center\">\n    <span class=\"badge bg-danger me-3\">UPDATE</span>\n    <div id=\"ticker-content\" style=\"flex:1;\">Carregando...</div>\n  </div>\n</div>",
  "estrutura_navbar": "<header class=\"navbar navbar-expand-lg sticky-top bg-body-tertiary shadow-sm py-3\" style=\"z-index: 1050;\">\n  <div class=\"container\">\n\n    <!-- LOGO (via b:widget Header, id='header-logo') -->\n    <a class=\"navbar-brand fw-bold fs-3 m-0\" href=\"/\">\n      <i class=\"bi bi-cpu me-2\"></i>Nome do Blog\n    </a>\n\n    <!-- TOGGLE MOBILE -->\n    <button class=\"navbar-toggler border-0\" type=\"button\"\n      data-bs-toggle=\"collapse\" data-bs-target=\"#mainNavbar\"\n      aria-controls=\"mainNavbar\" aria-expanded=\"false\" aria-label=\"Toggle navigation\">\n      <span class=\"navbar-toggler-icon\"></span>\n    </button>\n\n    <!-- NAV COLLAPSE (via b:widget LinkList, id='nav-section') -->\n    <div class=\"collapse navbar-collapse\" id=\"mainNavbar\">\n      <ul class=\"navbar-nav ms-auto\" id=\"blogger-nav\">\n        <li class=\"nav-item\"><a class=\"nav-link fw-bold text-uppercase\" href=\"/\">Início</a></li>\n        <li class=\"nav-item\"><a class=\"nav-link fw-bold text-uppercase\" href=\"/p/sobre.html\">Sobre</a></li>\n      </ul>\n\n      <!-- GRUPO DE AÇÕES: divider + dark mode + busca -->\n      <div class=\"d-flex ms-lg-3 mt-3 mt-lg-0 border-start ps-lg-3\">\n        <button class=\"btn btn-outline-secondary rounded-circle\"\n          id=\"darkModeToggle\" type=\"button\" style=\"width:40px; height:40px;\">\n          <i class=\"bi bi-moon-stars-fill\"></i>\n        </button>\n        <button class=\"btn btn-outline-secondary rounded-circle ms-2 d-flex align-items-center justify-content-center\"\n          type=\"button\" data-bs-toggle=\"modal\" data-bs-target=\"#searchModal\"\n          style=\"width:40px; height:40px;\">\n          <i class=\"bi bi-search\"></i>\n        </button>\n      </div>\n    </div>\n\n  </div>\n</header>",
  "blogger_widget_logo": "<b:section id='header-logo' maxwidgets='1' showaddelement='yes'>\n  <b:widget id='Header1' type='Header' version='2' visible='true'>\n    <b:includable id='main'>\n      <a class='navbar-brand fw-bold fs-3 m-0' expr:href='data:blog.homepageUrl'>\n        <i class='bi bi-cpu me-2'/><data:title/>\n      </a>\n    </b:includable>\n  </b:widget>\n</b:section>",
  "blogger_widget_nav": "<b:section class='ms-auto' id='nav-section' maxwidgets='1' showaddelement='yes'>\n  <b:widget id='LinkList1' type='LinkList' version='2' visible='true'>\n    <b:includable id='main'>\n      <ul class='navbar-nav' id='blogger-nav'>\n        <b:loop values='data:links' var='link'>\n          <li class='nav-item'>\n            <a class='nav-link fw-bold text-uppercase' expr:href='data:link.href'><data:link.title/></a>\n          </li>\n        </b:loop>\n      </ul>\n    </b:includable>\n  </b:widget>\n</b:section>",
  "css_navbar": ".navbar-nav .nav-link { font-weight: 700; text-transform: uppercase; font-size: 0.9rem; letter-spacing: 0.5px; }\n@media (min-width: 992px) {\n  .navbar .dropdown:hover .dropdown-menu {\n    display: block;\n    margin-top: 0;\n    border-radius: 0 0 8px 8px;\n    box-shadow: 0 10px 15px rgba(0,0,0,0.1);\n  }\n}",
  "icones_logo_por_nicho": {
    "tecnologia": "bi-cpu",
    "games": "bi-controller",
    "noticias": "bi-newspaper",
    "culinaria": "bi-egg-fried",
    "saude": "bi-heart-pulse",
    "financas": "bi-graph-up-arrow",
    "viagens": "bi-compass",
    "educacao": "bi-mortarboard",
    "moda": "bi-bag",
    "esportes": "bi-trophy"
  },
  "notas_tecnicas": [
    "z-index: 1050 no header sticky é necessário para ficar acima de cards e modals de baixo z-index",
    "O grupo de ações usa border-start + ps-lg-3 como separador visual — no mobile (mt-3 mt-lg-0) fica empilhado sem borda",
    "navbar-toggler border-0 remove a borda padrão Bootstrap do botão hambúrguer — mais limpo",
    "id='blogger-nav' é necessário para o JS de dropdown dinâmico funcionar (links prefixados com _ viram subitens)",
    "O ticker-bar deve ser FORA do header — é um elemento irmão acima, nunca dentro do navbar",
    "sticky-top + shadow-sm cria a ilusão de que o header flutua sobre o conteúdo ao rolar"
  ]
}
