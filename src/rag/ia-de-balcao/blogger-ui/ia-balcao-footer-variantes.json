{
  "id": "ia-balcao-footer-variantes",
  "categoria": "footer-ui",
  "conceito": "Variantes de rodapé para templates Blogger Bootstrap 5.3: footer completo com 4 colunas, footer minimalista centralizado, footer com newsletter, e footer dark com gradiente. Todos com variáveis --sl-* e sem tags b: inline.",

  "footer_4_colunas": {
    "descricao": "Footer completo com 4 colunas: sobre, links rápidos, categorias, e redes sociais. Responsivo: 2 colunas em tablet, 1 em mobile.",
    "html": "<footer style=\"background:var(--sl-footer-bg,#1a1a2e);color:var(--sl-footer-text,#ccc)\">\n  <div class=\"container py-5\">\n    <div class=\"row g-4\">\n      <div class=\"col-lg-3 col-md-6\">\n        <h5 class=\"fw-bold mb-3\" style=\"color:#fff\">Nome do Blog</h5>\n        <p class=\"small opacity-75 mb-3\">O melhor conteúdo de tecnologia, reviews e tutoriais do Brasil. Publicamos semanalmente.</p>\n        <div class=\"d-flex gap-2\">\n          <a href=\"#\" class=\"btn btn-sm rounded-circle\" style=\"background:rgba(255,255,255,.1);color:#fff;width:34px;height:34px;display:flex;align-items:center;justify-content:center\" aria-label=\"Facebook\"><i class=\"bi bi-facebook\"></i></a>\n          <a href=\"#\" class=\"btn btn-sm rounded-circle\" style=\"background:rgba(255,255,255,.1);color:#fff;width:34px;height:34px;display:flex;align-items:center;justify-content:center\" aria-label=\"Twitter\"><i class=\"bi bi-twitter-x\"></i></a>\n          <a href=\"#\" class=\"btn btn-sm rounded-circle\" style=\"background:rgba(255,255,255,.1);color:#fff;width:34px;height:34px;display:flex;align-items:center;justify-content:center\" aria-label=\"YouTube\"><i class=\"bi bi-youtube\"></i></a>\n        </div>\n      </div>\n      <div class=\"col-lg-3 col-md-6\">\n        <h6 class=\"fw-bold mb-3\" style=\"color:#fff\">Links Rápidos</h6>\n        <ul class=\"list-unstyled small\">\n          <li class=\"mb-2\"><a href=\"/\" class=\"text-decoration-none opacity-75\" style=\"color:var(--sl-footer-text,#ccc)\"><i class=\"bi bi-chevron-right small me-1\"></i>Início</a></li>\n          <li class=\"mb-2\"><a href=\"/p/sobre.html\" class=\"text-decoration-none opacity-75\" style=\"color:var(--sl-footer-text,#ccc)\"><i class=\"bi bi-chevron-right small me-1\"></i>Sobre</a></li>\n          <li class=\"mb-2\"><a href=\"/p/contato.html\" class=\"text-decoration-none opacity-75\" style=\"color:var(--sl-footer-text,#ccc)\"><i class=\"bi bi-chevron-right small me-1\"></i>Contato</a></li>\n          <li class=\"mb-2\"><a href=\"/p/privacidade.html\" class=\"text-decoration-none opacity-75\" style=\"color:var(--sl-footer-text,#ccc)\"><i class=\"bi bi-chevron-right small me-1\"></i>Privacidade</a></li>\n          <li><a href=\"/sitemap.xml\" class=\"text-decoration-none opacity-75\" style=\"color:var(--sl-footer-text,#ccc)\"><i class=\"bi bi-chevron-right small me-1\"></i>Sitemap</a></li>\n        </ul>\n      </div>\n      <div class=\"col-lg-3 col-md-6\">\n        <h6 class=\"fw-bold mb-3\" style=\"color:#fff\">Categorias</h6>\n        <ul class=\"list-unstyled small\">\n          <li class=\"mb-2\"><a href=\"/search/label/android\" class=\"text-decoration-none opacity-75\" style=\"color:var(--sl-footer-text,#ccc)\">Android</a></li>\n          <li class=\"mb-2\"><a href=\"/search/label/ios\" class=\"text-decoration-none opacity-75\" style=\"color:var(--sl-footer-text,#ccc)\">iOS</a></li>\n          <li class=\"mb-2\"><a href=\"/search/label/review\" class=\"text-decoration-none opacity-75\" style=\"color:var(--sl-footer-text,#ccc)\">Reviews</a></li>\n          <li class=\"mb-2\"><a href=\"/search/label/tutorial\" class=\"text-decoration-none opacity-75\" style=\"color:var(--sl-footer-text,#ccc)\">Tutoriais</a></li>\n          <li><a href=\"/search/label/lancamentos\" class=\"text-decoration-none opacity-75\" style=\"color:var(--sl-footer-text,#ccc)\">Lançamentos</a></li>\n        </ul>\n      </div>\n      <div class=\"col-lg-3 col-md-6\">\n        <h6 class=\"fw-bold mb-3\" style=\"color:#fff\">Newsletter</h6>\n        <p class=\"small opacity-75 mb-3\">Receba os melhores posts diretamente no seu e-mail.</p>\n        <div class=\"input-group input-group-sm\">\n          <input type=\"email\" class=\"form-control\" placeholder=\"seu@email.com\" style=\"border-radius:6px 0 0 6px\">\n          <button class=\"btn btn-sm fw-semibold\" style=\"background:var(--sl-primary);color:#fff;border-radius:0 6px 6px 0\" type=\"button\">OK</button>\n        </div>\n        <p class=\"mt-2\" style=\"font-size:.72rem;opacity:.5\">Sem spam. Cancele quando quiser.</p>\n      </div>\n    </div>\n  </div>\n  <div class=\"border-top py-3\" style=\"border-color:rgba(255,255,255,.1)!important\">\n    <div class=\"container d-flex flex-column flex-md-row justify-content-between align-items-center gap-2\">\n      <p class=\"small mb-0 opacity-50\">2025 Nome do Blog. Todos os direitos reservados.</p>\n      <p class=\"small mb-0 opacity-50\">Feito com <i class=\"bi bi-heart-fill text-danger\"></i> no Brasil</p>\n    </div>\n  </div>\n</footer>",
    "css": "footer a:hover{opacity:1!important;color:var(--sl-primary)!important}"
  },

  "footer_minimalista": {
    "descricao": "Footer minimalista centralizado: logo, 5 links inline, copyright. Para blogs pessoais e portfólios.",
    "html": "<footer class=\"py-4 border-top\" style=\"background:var(--sl-bg-body,#fff)\">\n  <div class=\"container text-center\">\n    <a class=\"d-block fw-bold fs-5 mb-3 text-decoration-none\" href=\"/\" style=\"color:var(--sl-primary)\">Nome do Blog</a>\n    <nav class=\"mb-3\">\n      <ul class=\"list-inline mb-0\">\n        <li class=\"list-inline-item\"><a href=\"/\" class=\"small text-decoration-none\" style=\"color:var(--sl-text-main)\">Início</a></li>\n        <li class=\"list-inline-item text-muted\">·</li>\n        <li class=\"list-inline-item\"><a href=\"/p/sobre.html\" class=\"small text-decoration-none\" style=\"color:var(--sl-text-main)\">Sobre</a></li>\n        <li class=\"list-inline-item text-muted\">·</li>\n        <li class=\"list-inline-item\"><a href=\"/p/contato.html\" class=\"small text-decoration-none\" style=\"color:var(--sl-text-main)\">Contato</a></li>\n        <li class=\"list-inline-item text-muted\">·</li>\n        <li class=\"list-inline-item\"><a href=\"/p/privacidade.html\" class=\"small text-decoration-none\" style=\"color:var(--sl-text-main)\">Privacidade</a></li>\n      </ul>\n    </nav>\n    <p class=\"text-muted mb-0\" style=\"font-size:.8rem\">2025 Nome do Blog</p>\n  </div>\n</footer>",
    "css": "footer a:hover{color:var(--sl-primary)!important}"
  },

  "footer_dark_gradiente": {
    "descricao": "Footer dark com gradiente diagonal, separador colorido no topo, logo grande, e links de conformidade.",
    "html": "<footer class=\"position-relative\" style=\"background:linear-gradient(135deg,#0f0c29,#302b63,#24243e);color:rgba(255,255,255,.8)\">\n  <div style=\"height:3px;background:linear-gradient(90deg,var(--sl-primary),var(--sl-accent,#7c3aed))\"></div>\n  <div class=\"container py-5\">\n    <div class=\"row g-4 align-items-start\">\n      <div class=\"col-lg-4\">\n        <h4 class=\"fw-bold fs-3 mb-2\" style=\"color:#fff\">NOME DO BLOG</h4>\n        <p class=\"small opacity-60 mb-4\">Reviews, tutoriais e novidades do universo tech.</p>\n        <div class=\"d-flex gap-2\">\n          <a href=\"#\" class=\"btn btn-sm\" style=\"background:rgba(255,255,255,.08);color:#fff;border-radius:8px\" aria-label=\"Instagram\"><i class=\"bi bi-instagram\"></i></a>\n          <a href=\"#\" class=\"btn btn-sm\" style=\"background:rgba(255,255,255,.08);color:#fff;border-radius:8px\" aria-label=\"YouTube\"><i class=\"bi bi-youtube\"></i></a>\n          <a href=\"#\" class=\"btn btn-sm\" style=\"background:rgba(255,255,255,.08);color:#fff;border-radius:8px\" aria-label=\"TikTok\"><i class=\"bi bi-tiktok\"></i></a>\n        </div>\n      </div>\n      <div class=\"col-lg-4 col-md-6\">\n        <h6 class=\"fw-bold mb-3\" style=\"color:rgba(255,255,255,.5);text-transform:uppercase;letter-spacing:1px;font-size:.75rem\">Explorar</h6>\n        <ul class=\"list-unstyled small\">\n          <li class=\"mb-2\"><a href=\"/search/label/android\" class=\"text-decoration-none\" style=\"color:rgba(255,255,255,.7)\">Android</a></li>\n          <li class=\"mb-2\"><a href=\"/search/label/ios\" class=\"text-decoration-none\" style=\"color:rgba(255,255,255,.7)\">iOS</a></li>\n          <li class=\"mb-2\"><a href=\"/search/label/review\" class=\"text-decoration-none\" style=\"color:rgba(255,255,255,.7)\">Reviews</a></li>\n        </ul>\n      </div>\n      <div class=\"col-lg-4 col-md-6\">\n        <h6 class=\"fw-bold mb-3\" style=\"color:rgba(255,255,255,.5);text-transform:uppercase;letter-spacing:1px;font-size:.75rem\">Legal</h6>\n        <ul class=\"list-unstyled small\">\n          <li class=\"mb-2\"><a href=\"/p/privacidade.html\" class=\"text-decoration-none\" style=\"color:rgba(255,255,255,.7)\">Política de Privacidade</a></li>\n          <li class=\"mb-2\"><a href=\"/p/termos.html\" class=\"text-decoration-none\" style=\"color:rgba(255,255,255,.7)\">Termos de Uso</a></li>\n          <li><a href=\"/p/cookies.html\" class=\"text-decoration-none\" style=\"color:rgba(255,255,255,.7)\">Cookies</a></li>\n        </ul>\n      </div>\n    </div>\n    <div class=\"border-top mt-4 pt-3\" style=\"border-color:rgba(255,255,255,.1)!important\">\n      <p class=\"small mb-0 text-center\" style=\"opacity:.4\">2025 Nome do Blog. Todos os direitos reservados.</p>\n    </div>\n  </div>\n</footer>",
    "css": "footer a:hover{color:#fff!important;opacity:1!important}"
  },

  "notas_tecnicas": [
    "footer_4_colunas: a coluna de newsletter tem input de e-mail estático — para funcionar, integrar com Mailchimp ou FeedBurner via action form",
    "Todos os footers evitam tags b: e data: — a URL do blog e o nome devem ser substituídos no template XML pelo compilador",
    "footer_dark_gradiente: a barra colorida no topo usa div de 3px com gradiente — mais confiável que border-top com gradient",
    "footer_minimalista: list-inline com pontos de separador (·) é mais semântico que border-right em cada item",
    "--sl-footer-bg e --sl-footer-text devem ser declarados no :root do tema para manter consistência com dark mode",
    "O footer deve estar FORA do main container do Blogger — dentro de um b:section separado ou como HTML estático no template"
  ]
}
