  <script src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js'/>
  <script>
  //<![CDATA[
  document.addEventListener('DOMContentLoaded', () => {

    /* Achado 5 — JS da peça dark-mode-toggle-scroll, embutido aqui
       (mesmo raciocínio: botão não é fixo-posicionado, HTML escrito na
       posição real acima; JS precisa rodar independente de onde o
       botão vive no DOM, já que busca por classe). */
    const setTheme = t => { document.documentElement.setAttribute('data-bs-theme', t); localStorage.setItem('theme', t); document.querySelector('.btn-dark-mode i').className = t === 'dark' ? 'bi bi-sun-fill fs-6 text-warning' : 'bi bi-moon-stars-fill fs-6'; };
    setTheme(localStorage.getItem('theme') || 'dark');
    document.querySelectorAll('.btn-dark-mode').forEach(b => b.addEventListener('click', () => setTheme(document.documentElement.getAttribute('data-bs-theme') === 'dark' ? 'light' : 'dark')));

    const obs = new IntersectionObserver(es => es.forEach(e => { if(e.isIntersecting) { e.target.classList.add('visible'); obs.unobserve(e.target); } }), {threshold: 0.1});
    document.querySelectorAll('.animate-up, .game-card').forEach((el, i) => { if(el.classList.contains('game-card')) el.style.transitionDelay = `${(i % 2) * 0.1}s`; el.classList.add('animate-up'); obs.observe(el); });

    /* =================================================================
       MOTOR DE SHORTCODES (VANILLA JS CUSTOMIZADO, achado 2)
       Transforma [review ...] numa caixa de pontuação
       ================================================================= */
    const postBodies = document.querySelectorAll('.post-body-content');

    postBodies.forEach(post => {
      let contentHtml = post.innerHTML;
      const reviewRegex = /\[review\s+([^\]]+)\]/gi;

      if (reviewRegex.test(contentHtml)) {

        contentHtml = contentHtml.replace(reviewRegex, (match, atributosString) => {

          const attrs = {};
          const extractRegex = /(\w+)="([^"]+)"/g;
          let attrMatch;
          while ((attrMatch = extractRegex.exec(atributosString)) !== null) {
            attrs[attrMatch[1]] = attrMatch[2];
          }

          const titulo = attrs.titulo || 'Veredicto Final';
          const notaFinal = attrs.nota || '0.0';
          const valGrafico = attrs.grafico || '0';
          const valSom = attrs.som || '0';
          const valGameplay = attrs.gameplay || '0';

          return `
            <div class="shortcode-review-box z-1">
              <div class="row align-items-center position-relative z-1">

                <div class="col-md-8 mb-4 mb-md-0">
                  <h3 class="oswald-font fs-3 text-white mb-4 d-flex align-items-center gap-2">
                    <i class="bi bi-controller text-primary"></i> ${titulo}
                  </h3>

                  <div class="mb-3">
                    <div class="d-flex justify-content-between small fw-bold mb-1 text-uppercase text-secondary"><span>Gráficos</span><span>${valGrafico}/10</span></div>
                    <div class="review-bar-container"><div class="review-bar-fill" style="width: ${valGrafico}0%;"></div></div>
                  </div>

                  <div class="mb-3">
                    <div class="d-flex justify-content-between small fw-bold mb-1 text-uppercase text-secondary"><span>Som / Trilha</span><span>${valSom}/10</span></div>
                    <div class="review-bar-container"><div class="review-bar-fill" style="width: ${valSom}0%;"></div></div>
                  </div>

                  <div class="mb-2">
                    <div class="d-flex justify-content-between small fw-bold mb-1 text-uppercase text-secondary"><span>Jogabilidade</span><span>${valGameplay}/10</span></div>
                    <div class="review-bar-container"><div class="review-bar-fill" style="width: ${valGameplay}0%;"></div></div>
                  </div>
                </div>

                <div class="col-md-4 d-flex justify-content-center border-start border-secondary border-opacity-25">
                  <div class="text-center">
                    <div class="small fw-bold text-uppercase text-primary mb-2" style="letter-spacing: 2px;">Nota Final</div>
                    <div class="review-score-circle mx-auto">${notaFinal}</div>
                  </div>
                </div>

              </div>
            </div>
          `;
        });

        post.innerHTML = contentHtml;
      }
    });

    /* Ripple Effect */
    document.querySelectorAll('.btn, .nav-link').forEach(button => {
      button.addEventListener('click', function(e) {
        let x = e.clientX - e.target.getBoundingClientRect().left;
        let y = e.clientY - e.target.getBoundingClientRect().top;

        let ripple = document.createElement('span');
        ripple.style.left = x + 'px';
        ripple.style.top = y + 'px';
        ripple.classList.add('ripple-effect');

        this.appendChild(ripple);

        setTimeout(() => { ripple.remove(); }, 600);
      });
    });

  });
  //]]>
  </script>

  <!-- JS do nicho (dossiê — hoje sem peças 'modulo'/'hero' com js
       próprio, token mantido por consistência com os demais esqueletos). -->
  [[NICHO_JS]]

