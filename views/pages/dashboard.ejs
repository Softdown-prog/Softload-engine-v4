<%- include('../partials/header') %>

<div class="sl-dash-wrapper">

    <%- include('../partials/dashboard-sidebar', { activePage: 'home', user: user }) %>

    <main class="flex-grow-1 overflow-auto" style="min-width:0">

        <!-- Topbar mobile -->
        <div class="sl-topbar d-lg-none">
            <span class="flex-grow-1 fw-bolder text-uppercase small" style="color:var(--bs-body-color);letter-spacing:-0.02em">Painel</span>
            <a href="/dashboard/configuracoes" title="Configurações" class="btn btn-link p-1" style="color:var(--sl-text-400)">
                <i class="bi bi-gear-fill" style="font-size:1.2rem"></i>
            </a>
        </div>

        <!-- Conteúdo -->
        <div class="p-3 p-md-5">

            <!-- Header desktop -->
            <div class="d-none d-lg-flex align-items-start justify-content-between mb-5">
                <div>
                    <h1 class="fw-bolder text-uppercase mb-1" style="font-size:1.4rem;letter-spacing:-0.03em;font-weight:900">
                        Bem-vindo, <%= (user.nome || 'Usuário').split(' ')[0] %>
                    </h1>
                    <p class="small mb-0" style="color:var(--sl-text-500)">Central de controle do motor Softload.</p>
                </div>
                <a href="/dashboard/configuracoes" title="Configurações" class="mt-1" style="color:var(--sl-text-400);text-decoration:none;transition:color 0.2s"
                   onmouseover="this.style.color='var(--bs-body-color)'" onmouseout="this.style.color='var(--sl-text-400)'">
                    <svg width="22" height="22" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path fill-rule="evenodd" clip-rule="evenodd" d="M8.625 1.04232C8.54924 0.814981 8.3371 0.65 8.09635 0.65H6.90364C6.66289 0.65 6.45076 0.814981 6.37499 1.04232L6.10811 1.84293C5.69666 1.98403 5.3113 2.1691 4.96024 2.39178L4.22591 1.86532C4.03264 1.72671 3.7663 1.7454 3.59368 1.91802L2.75276 2.75893C2.58014 2.93156 2.56146 3.1979 2.69999 3.39121L3.22656 4.12563C3.00392 4.47665 2.81888 4.86196 2.6778 5.27335L1.87707 5.54024C1.64974 5.616 1.48476 5.82814 1.48476 6.06889V7.2616C1.48476 7.50235 1.64974 7.71449 1.87707 7.79025L2.6778 8.05714C2.81888 8.46853 3.00392 8.85384 3.22656 9.20486L2.69999 9.93928C2.56146 10.1326 2.58014 10.3989 2.75276 10.5716L3.59368 11.4125C3.7663 11.5851 4.03264 11.6038 4.22591 11.4652L4.96024 10.9387C5.3113 11.1614 5.69666 11.3465 6.10811 11.4876L6.37499 12.2882C6.45076 12.5155 6.66289 12.6805 6.90364 12.6805H8.09635C8.3371 12.6805 8.54924 12.5155 8.625 12.2882L8.89188 11.4876C9.30334 11.3465 9.68869 11.1614 10.0397 10.9387L10.7741 11.4652C10.9673 11.6038 11.2337 11.5851 11.4063 11.4125L12.2472 10.5716C12.4198 10.3989 12.4385 10.1326 12.3 9.93928L11.7734 9.20486C11.9961 8.85384 12.1811 8.46853 12.3222 8.05714L13.1229 7.79025C13.3502 7.71449 13.5152 7.50235 13.5152 7.2616V6.06889C13.5152 5.82814 13.3502 5.616 13.1229 5.54024L12.3222 5.27335C12.1811 4.86196 11.9961 4.47665 11.7734 4.12563L12.3 3.39121C12.4385 3.1979 12.4198 2.93156 12.2472 2.75893L11.4063 1.91802C11.2337 1.7454 10.9673 1.72671 10.7741 1.86532L10.0397 2.39178C9.68869 2.1691 9.30334 1.98403 8.89188 1.84293L8.625 1.04232ZM7.49999 9.34049C8.68213 9.34049 9.64049 8.38213 9.64049 7.19999C9.64049 6.01786 8.68213 5.05949 7.49999 5.05949C6.31786 5.05949 5.35949 6.01786 5.35949 7.19999C5.35949 8.38213 6.31786 9.34049 7.49999 9.34049Z" fill="currentColor"/>
                    </svg>
                </a>
            </div>

            <!-- Stats -->
            <div class="row g-3 mb-5 row-cols-xl-5">

                <!-- Plano -->
                <div class="col-12 col-md-6 col-xl">
                    <div class="sl-card h-100 mb-0">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <i class="bi bi-shield-check" style="font-size:1.2rem;color:var(--sl-primary)"></i>
                            <span class="fw-bolder text-uppercase font-monospace" style="font-size:9px;color:var(--sl-text-400);letter-spacing:0.2em">Plano</span>
                        </div>
                        <p class="fw-bolder mb-1 text-capitalize" style="font-size:1.1rem"><%= user.plano || 'Gratuito' %></p>
                        <% if (user.is_active && user.premium_ate) { %>
                            <p class="small mb-0" style="color:var(--sl-text-400)">
                                Expira em <%= new Date(user.premium_ate).toLocaleDateString('pt-BR') %>
                            </p>
                        <% } else if (!user.is_active) { %>
                            <a href="/dashboard/upgrade" class="small fw-bold text-decoration-none d-block" style="color:var(--sl-primary)">Ativar licença →</a>
                        <% } %>
                    </div>
                </div>

                <!-- Compilações -->
                <div class="col-12 col-md-6 col-xl">
                    <div class="sl-card h-100 mb-0">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <i class="bi bi-lightning-charge" style="font-size:1.2rem;color:#eab308"></i>
                            <span class="fw-bolder text-uppercase font-monospace" style="font-size:9px;color:var(--sl-text-400);letter-spacing:0.2em">Compilações</span>
                        </div>
                        <p class="fw-bolder mb-1" style="font-size:1.1rem"><%= user.tentativas_compilacao || 0 %></p>
                        <p class="small mb-0" style="color:var(--sl-text-400)">templates gerados no total</p>
                    </div>
                </div>

                <!-- Armazenamento -->
                <div class="col-12 col-md-6 col-xl">
                    <div class="sl-card h-100 mb-0">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <i class="bi bi-hdd" style="font-size:1.2rem;color:#a855f7"></i>
                            <span class="fw-bolder text-uppercase font-monospace" style="font-size:9px;color:var(--sl-text-400);letter-spacing:0.2em">Armazenamento</span>
                        </div>
                        <p class="fw-bolder mb-2" style="font-size:1.1rem">
                            <%= (user.storage_usado_mb || 0).toFixed(1) %>
                            <span class="fw-normal small" style="color:var(--sl-text-400)">/ <%= storageLimitMb %> MB</span>
                        </p>
                        <div class="rounded-pill" style="height:4px;background:var(--sl-bg-800)">
                            <div class="rounded-pill" style="height:4px;background:var(--sl-primary);width:<%= Math.min(((user.storage_usado_mb || 0) / storageLimitMb) * 100, 100).toFixed(1) %>%"></div>
                        </div>
                    </div>
                </div>

                <!-- Créditos Gemini -->
                <%
                    var creditosUsados = creditosCicloTotal - creditos;
                    var creditosPct   = creditosCicloTotal > 0 ? Math.min((creditosUsados / creditosCicloTotal) * 100, 100) : 0;
                    var barColor      = creditosPct >= 80 ? 'linear-gradient(90deg,#f59e0b,#ef4444)'
                                      : creditosPct >= 55 ? 'linear-gradient(90deg,#22c55e,#f59e0b)'
                                      : 'linear-gradient(90deg,#22c55e,#6366f1)';
                    var diasRestantes = null;
                    if (creditosExpiraEm) {
                        var msRestantes = new Date(creditosExpiraEm) - new Date();
                        diasRestantes = Math.max(0, Math.ceil(msRestantes / (1000 * 60 * 60 * 24)));
                    }
                %>
                <div class="col-12 col-md-6 col-xl">
                    <div class="sl-card h-100 mb-0">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <i class="bi bi-lightning-charge-fill" style="font-size:1.2rem;color:#818cf8"></i>
                            <span class="fw-bolder text-uppercase font-monospace" style="font-size:9px;color:var(--sl-text-400);letter-spacing:0.2em">Créditos IA</span>
                        </div>
                        <div class="d-flex align-items-baseline gap-1 mb-2">
                            <p class="fw-bolder mb-0" style="font-size:1.1rem;font-variant-numeric:tabular-nums">
                                <%= creditos.toLocaleString('pt-BR') %>
                            </p>
                            <span class="small" style="color:var(--sl-text-400)">/ <%= creditosCicloTotal.toLocaleString('pt-BR') %></span>
                        </div>
                        <div class="rounded-pill mb-2" style="height:4px;background:var(--sl-bg-800);overflow:hidden">
                            <div class="rounded-pill" style="height:4px;width:<%= creditosPct.toFixed(1) %>%;background:<%= barColor %>;transition:width .55s ease"></div>
                        </div>
                        <p class="small mb-2" style="color:var(--sl-text-400)">
                            <% if (diasRestantes !== null) { %>
                                expira em <%= diasRestantes %> dia<%= diasRestantes !== 1 ? 's' : '' %>
                            <% } else { %>
                                créditos do ciclo atual
                            <% } %>
                        </p>
                        <div class="d-flex gap-2">
                            <span style="font-size:.68rem;font-weight:700;padding:2px 8px;border-radius:20px;background:rgba(99,102,241,.12);color:#818cf8;border:1px solid rgba(99,102,241,.25)">
                                <i class="bi bi-stars" style="font-size:.58rem"></i> Blogger AI
                            </span>
                            <span style="font-size:.68rem;font-weight:700;padding:2px 8px;border-radius:20px;background:rgba(14,165,233,.1);color:var(--sl-primary);border:1px solid rgba(14,165,233,.2)">
                                <i class="bi bi-patch-check" style="font-size:.58rem"></i> Chat IA
                            </span>
                        </div>
                    </div>
                </div>

                <!-- Créditos GPT 5.4 -->
                <%
                    var gptUsados     = creditosGptCicloTotal - creditosGpt;
                    var gptPct        = creditosGptCicloTotal > 0 ? Math.min((gptUsados / creditosGptCicloTotal) * 100, 100) : 0;
                    var gptBarColor   = gptPct >= 80 ? 'linear-gradient(90deg,#f59e0b,#ef4444)'
                                      : gptPct >= 55 ? 'linear-gradient(90deg,#22c55e,#f59e0b)'
                                      : 'linear-gradient(90deg,#10b981,#059669)';
                    var gptDias = null;
                    if (creditosGptExpiraEm) {
                        var gptMs = new Date(creditosGptExpiraEm) - new Date();
                        gptDias   = Math.max(0, Math.ceil(gptMs / (1000 * 60 * 60 * 24)));
                    }
                %>
                <div class="col-12 col-md-6 col-xl">
                    <div class="sl-card h-100 mb-0">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <i class="bi bi-chat-square-dots-fill" style="font-size:1.2rem;color:#10b981"></i>
                            <span class="fw-bolder text-uppercase font-monospace" style="font-size:9px;color:var(--sl-text-400);letter-spacing:0.2em">Créditos GPT 5.4</span>
                        </div>
                        <% if (creditosGptCicloTotal > 0) { %>
                            <div class="d-flex align-items-baseline gap-1 mb-2">
                                <p class="fw-bolder mb-0" style="font-size:1.1rem;font-variant-numeric:tabular-nums">
                                    <%= creditosGpt.toLocaleString('pt-BR') %>
                                </p>
                                <span class="small" style="color:var(--sl-text-400)">/ <%= creditosGptCicloTotal.toLocaleString('pt-BR') %></span>
                            </div>
                            <div class="rounded-pill mb-2" style="height:4px;background:var(--sl-bg-800);overflow:hidden">
                                <div class="rounded-pill" style="height:4px;width:<%= gptPct.toFixed(1) %>%;background:<%= gptBarColor %>;transition:width .55s ease"></div>
                            </div>
                            <p class="small mb-0" style="color:var(--sl-text-400)">
                                <% if (gptDias !== null) { %>
                                    expira em <%= gptDias %> dia<%= gptDias !== 1 ? 's' : '' %>
                                <% } else { %>
                                    créditos do ciclo atual
                                <% } %>
                            </p>
                        <% } else { %>
                            <p class="fw-bolder mb-1" style="font-size:1.1rem;color:var(--sl-text-500)">—</p>
                            <p class="small mb-0" style="color:var(--sl-text-500)">disponível no plano Studio</p>
                        <% } %>
                    </div>
                </div>

            </div>

            <!-- Ferramentas -->
            <div>
                <p class="fw-bolder text-uppercase mb-3" style="font-size:10px;color:var(--sl-text-400);letter-spacing:0.3em">Ferramentas Disponíveis</p>

                <div class="row g-3">

                    <!-- Especialista Blogger -->
                    <div class="col-12 col-md-6">
                        <div class="sl-card mb-0 h-100">
                            <div class="d-flex align-items-start justify-content-between mb-4">
                                <div class="rounded-3 d-flex align-items-center justify-content-center"
                                     style="width:40px;height:40px;background:rgba(14,165,233,0.1);border:1px solid rgba(14,165,233,0.2)">
                                    <i class="bi bi-patch-check" style="color:var(--sl-primary-light)"></i>
                                </div>
                                <span class="fw-bolder text-uppercase" style="font-size:9px;letter-spacing:0.15em;background:rgba(14,165,233,.12);color:var(--sl-primary);padding:3px 8px;border-radius:6px">Gemini</span>
                            </div>
                            <h3 class="fw-bold mb-1" style="font-size:0.95rem">Especialista Blogger</h3>
                            <p class="small mb-4" style="color:var(--sl-text-500)">Suporte técnico, snippets CSS/JS adaptados ao seu template, SEO e AdSense com IA especializada.</p>
                            <a href="/dashboard/chat" class="btn btn-sm w-100 fw-bolder text-uppercase small"
                               style="background:#0f172a;color:#fff;border:none;letter-spacing:0.1em">
                                Abrir Especialista <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>

                    <!-- Solaris Code -->
                    <div class="col-12 col-md-6">
                        <div class="sl-card mb-0 h-100">
                            <div class="d-flex align-items-start justify-content-between mb-4">
                                <div class="rounded-3 d-flex align-items-center justify-content-center"
                                     style="width:40px;height:40px;background:rgba(99,102,241,0.1);border:1px solid rgba(99,102,241,0.2)">
                                    <i class="bi bi-cpu" style="color:#818cf8"></i>
                                </div>
                                <span class="fw-bolder text-uppercase" style="font-size:9px;letter-spacing:0.15em;background:rgba(99,102,241,.12);color:#818cf8;padding:3px 8px;border-radius:6px">Novo</span>
                            </div>
                            <h3 class="fw-bold mb-1" style="font-size:0.95rem">Solaris Code</h3>
                            <p class="small mb-4" style="color:var(--sl-text-500)">Arquiteto de front-end/back-end leve com IA — motor independente do Compiler Blogger, pra projetos HTML5/CSS3/JS.</p>
                            <a href="/dashboard/solaris" class="btn btn-sm w-100 fw-bolder text-uppercase small"
                               style="background:#0f172a;color:#fff;border:none;letter-spacing:0.1em">
                                Abrir Solaris <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>

                    <!-- Histórico -->
                    <div class="col-12 col-md-6">
                        <div class="sl-card mb-0 h-100">
                            <div class="d-flex align-items-start justify-content-between mb-4">
                                <div class="rounded-3 d-flex align-items-center justify-content-center"
                                     style="width:40px;height:40px;background:rgba(14,165,233,0.1);border:1px solid rgba(14,165,233,0.2)">
                                    <i class="bi bi-clock-history" style="color:var(--sl-primary-light)"></i>
                                </div>
                                <span class="fw-bolder text-uppercase" style="font-size:9px;letter-spacing:0.15em;color:var(--sl-primary);background:rgba(14,165,233,0.1);padding:3px 8px;border-radius:6px">Disponível</span>
                            </div>
                            <h3 class="fw-bold mb-1" style="font-size:0.95rem">Histórico de Compilações</h3>
                            <p class="small mb-4" style="color:var(--sl-text-500)">Acesse e baixe novamente todos os templates que você já compilou.</p>
                            <a href="/dashboard/historico" class="btn btn-sm w-100 fw-bolder text-uppercase small"
                               style="background:#0f172a;color:#fff;border:none;letter-spacing:0.1em">
                                Ver Histórico <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>

                    <!-- Workspace -->
                    <div class="col-12 col-md-6">
                        <div class="sl-card mb-0 h-100">
                            <div class="d-flex align-items-start justify-content-between mb-4">
                                <div class="rounded-3 d-flex align-items-center justify-content-center"
                                     style="width:40px;height:40px;background:rgba(99,102,241,0.1);border:1px solid rgba(99,102,241,0.2)">
                                    <i class="bi bi-folder2-open" style="color:#818cf8"></i>
                                </div>
                                <span class="fw-bolder text-uppercase" style="font-size:9px;letter-spacing:0.15em;color:#818cf8;background:rgba(99,102,241,0.1);padding:3px 8px;border-radius:6px">
                                    <%= totalProjetos %> projeto<%= totalProjetos !== 1 ? 's' : '' %>
                                </span>
                            </div>
                            <h3 class="fw-bold mb-1" style="font-size:0.95rem">Workspace</h3>
                            <p class="small mb-4" style="color:var(--sl-text-500)">Organize projetos e sessões IA vinculadas ao estado exato do template no momento da geração.</p>
                            <a href="/dashboard/workspace" class="btn btn-sm w-100 fw-bolder text-uppercase small"
                               style="background:#0f172a;color:#fff;border:none;letter-spacing:0.1em">
                                Abrir Workspace <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>

                </div>
            </div>

        </div><!-- /conteúdo -->
    </main>
</div>


<%- include('../partials/footer') %>
