<%- include('../../partials/header') %>

<main class="d-flex align-items-center justify-content-center px-3 sl-pt-nav"
      style="min-height:100vh;background:var(--sl-bg-950);position:relative;overflow:hidden">

    <%# Decorative glow %>
    <div style="position:absolute;top:25%;left:25%;width:384px;height:384px;background:rgba(14,165,233,0.07);border-radius:50%;filter:blur(120px);pointer-events:none"></div>

    <div style="width:100%;max-width:440px;position:relative;z-index:1">

        <% if (typeof sucesso !== 'undefined' && sucesso) { %>
        <div class="alert alert-success fw-bold small text-center mb-4 rounded-3" role="alert">
            <%= sucesso %>
        </div>
        <% } %>

        <% if (typeof erro !== 'undefined' && erro) { %>
        <div class="alert alert-danger fw-bold small text-center mb-4 rounded-3" role="alert">
            <%= erro %>
        </div>
        <% } %>

        <div class="rounded-4 p-4 p-sm-5"
             style="background:rgba(15,23,42,0.5);backdrop-filter:blur(24px);border:1px solid var(--sl-bg-800)">

            <div class="text-center mb-4">
                <h1 class="fw-black text-white text-uppercase mb-1" style="letter-spacing:-0.03em">Acessar Fundição</h1>
                <p class="fw-bold text-uppercase mb-0" style="font-size:11px;color:var(--sl-text-500);letter-spacing:0.15em">Identifique-se para entrar no sistema</p>
            </div>

            <form action="/login" method="POST">
                <div class="mb-3">
                    <label for="email" class="d-block mb-1 fw-black text-uppercase"
                           style="font-size:10px;color:var(--sl-text-500);letter-spacing:0.15em">Identidade (E-mail)</label>
                    <div class="input-group">
                        <span class="input-group-text" style="background:rgba(15,23,42,0.7);border-color:var(--sl-bg-800)">
                            <i class="bi bi-envelope" style="color:var(--sl-text-500)"></i>
                        </span>
                        <input type="email" name="email" id="email" autocomplete="email" required
                               placeholder="seu@email.com"
                               class="form-control"
                               style="background:rgba(15,23,42,0.6);border-color:var(--sl-bg-800);color:#fff">
                    </div>
                </div>

                <div class="mb-3">
                    <label for="password" class="d-block mb-1 fw-black text-uppercase"
                           style="font-size:10px;color:var(--sl-text-500);letter-spacing:0.15em">Chave de Acesso</label>
                    <div class="input-group">
                        <span class="input-group-text" style="background:rgba(15,23,42,0.7);border-color:var(--sl-bg-800)">
                            <i class="bi bi-lock" style="color:var(--sl-text-500)"></i>
                        </span>
                        <input type="password" name="password" id="password" autocomplete="current-password" required
                               placeholder="••••••••"
                               class="form-control"
                               style="background:rgba(15,23,42,0.6);border-color:var(--sl-bg-800);color:#fff">
                        <button type="button" class="input-group-text" id="togglePwd"
                                onclick="togglePwd()"
                                style="background:rgba(15,23,42,0.7);border-color:var(--sl-bg-800);cursor:pointer">
                            <i class="bi bi-eye" id="togglePwdIcon" style="color:var(--sl-text-500)"></i>
                        </button>
                    </div>
                </div>

                <div class="d-flex justify-content-end mb-4">
                    <a href="/recover" class="fw-bold text-uppercase text-decoration-none"
                       style="font-size:10px;color:var(--sl-text-500);letter-spacing:0.1em">Esqueceu a chave?</a>
                </div>

                <button type="submit" class="btn btn-sl-primary w-100 fw-black text-uppercase"
                        style="letter-spacing:0.1em;height:48px">
                    Entrar no Sistema
                </button>
            </form>

            <div class="text-center mt-4">
                <p class="small mb-0" style="color:var(--sl-text-500)">
                    Novo usuário?
                    <a href="/register" class="fw-bold text-white text-decoration-none" style="transition:color .2s">Forjar Identidade</a>
                </p>
            </div>
        </div>
    </div>
</main>

<script>
function togglePwd() {
    var inp  = document.getElementById('password');
    var icon = document.getElementById('togglePwdIcon');
    var isHidden = inp.type === 'password';
    inp.type  = isHidden ? 'text' : 'password';
    icon.className = isHidden ? 'bi bi-eye-slash' : 'bi bi-eye';
    icon.style.color = isHidden ? 'var(--sl-primary-light)' : 'var(--sl-text-500)';
}
</script>

<%- include('../../partials/footer') %>
