<!DOCTYPE html>
<html lang="pt-BR" data-bs-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= titulo %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="/css/softload.css" rel="stylesheet">
    <style>
        body { background: var(--sl-bg-950); color: var(--sl-text-300); }
        .admin-topbar {
            position: fixed; top: 0; left: 0; right: 0; z-index: 1050;
            height: 56px; background: rgba(15,23,42,0.92);
            backdrop-filter: blur(20px); border-bottom: 1px solid var(--sl-bg-800);
            display: flex; align-items: center; padding: 0 1.5rem; gap: 1rem;
        }
        .admin-badge {
            font-size: 9px; font-weight: 900; text-transform: uppercase;
            letter-spacing: 0.18em; color: var(--sl-text-500);
            border: 1px solid var(--sl-bg-800); padding: 2px 8px; border-radius: 4px;
        }
        .kpi-card {
            background: rgba(15,23,42,0.6); border: 1px solid var(--sl-bg-800);
            border-radius: 1rem; padding: 1.25rem;
        }
        .section-card {
            background: rgba(15,23,42,0.6); border: 1px solid var(--sl-bg-800);
            border-radius: 1rem; overflow: hidden;
        }
        .section-label {
            font-size: 10px; font-weight: 900; text-transform: uppercase;
            letter-spacing: 0.18em; color: var(--sl-text-400);
        }
        .an-table th {
            font-size: 9px; font-weight: 900; text-transform: uppercase;
            letter-spacing: 0.15em; color: var(--sl-text-500);
            border-bottom: 1px solid var(--sl-bg-800) !important;
            padding: 10px 16px; background: rgba(15,23,42,0.4);
            white-space: nowrap;
        }
        .an-table td {
            padding: 14px 16px; font-size: .83rem; font-weight: 600;
            border-bottom: 1px solid rgba(30,41,59,.6) !important;
            vertical-align: middle;
        }
        .an-table tr:last-child td { border-bottom: none !important; }
        .plan-chip {
            font-size: 8px; font-weight: 900; text-transform: uppercase;
            letter-spacing: .12em; padding: 3px 9px; border-radius: 6px;
        }
        .plan-studio  { background: rgba(139,92,246,.18); color: #a78bfa; }
        .plan-pro     { background: rgba(14,165,233,.15);  color: #38bdf8; }
        .plan-premium { background: rgba(245,158,11,.12);  color: #fbbf24; }
        .plan-free    { background: rgba(148,163,184,.1);  color: var(--sl-text-500); }
        .bar-bg { height: 6px; border-radius: 3px; background: rgba(148,163,184,.12); overflow: hidden; }
        .bar-fill { height: 100%; border-radius: 3px; transition: width .6s ease; }
        .pulse-dot { width:6px;height:6px;border-radius:50%;background:#22c55e;display:inline-block;animation:pulse 2s infinite; }
        @keyframes pulse { 0%,100%{opacity:1}50%{opacity:.4} }
        .period-btn.active { background: var(--sl-primary) !important; color: #fff !important; }
    </style>
</head>
<body>

<nav class="admin-topbar">
    <a href="/eu" class="fw-black text-white sl-brand text-decoration-none" style="font-size:1rem">
        SOFTLOAD<span class="sl-accent">ENGINE</span>
    </a>
    <span class="admin-badge">Admin</span>
    <div class="flex-grow-1"></div>
    <span class="d-none d-sm-flex align-items-center gap-2" style="font-size:10px;color:var(--sl-text-500)">
        <span class="pulse-dot" id="pollingDot"></span>Auto-refresh 60s
    </span>
    <a href="/eu" class="btn btn-sm fw-bold text-uppercase"
       style="background:var(--sl-bg-800);color:var(--sl-text-300);border:1px solid var(--sl-bg-800);letter-spacing:.08em;font-size:11px">
        <i class="bi bi-house"></i> Painel
    </a>
    <a href="/eu/usuarios" class="btn btn-sm fw-bold text-uppercase"
       style="background:var(--sl-bg-800);color:var(--sl-text-300);border:1px solid var(--sl-bg-800);letter-spacing:.08em;font-size:11px">
        <i class="bi bi-people"></i> Usuários
    </a>
    <a href="/logout" class="btn btn-sm fw-bold text-uppercase"
       style="background:transparent;color:#f87171;border:1px solid rgba(239,68,68,.3);letter-spacing:.08em;font-size:11px">
        <i class="bi bi-box-arrow-right"></i> Sair
    </a>
</nav>

<main style="padding-top:72px" class="px-3 px-md-5 py-4" id="analyticsMain">
<div class="mx-auto" style="max-width:1200px">

    <%# Banner: índice Firestore ausente %>
    <% if (typeof semIndice !== 'undefined' && semIndice) { %>
    <div class="d-flex align-items-start gap-3 mb-4 p-3 rounded-3"
         style="background:rgba(245,158,11,.08);border:1px solid rgba(245,158,11,.25)">
        <i class="bi bi-exclamation-triangle-fill flex-shrink-0" style="color:#fbbf24;margin-top:2px"></i>
        <div style="width:100%">
            <p class="fw-black mb-2" style="color:#fbbf24;font-size:.85rem">Índice Firestore não configurado</p>
            <p class="mb-2 small" style="color:var(--sl-text-400);line-height:1.6">
                A coleção <code>billing_logs</code> precisa de um índice de <em>collection group</em> em <code>criado_em</code>.
                O arquivo <code>firestore.indexes.json</code> já está correto — basta implantar via Firebase CLI:
            </p>
            <div class="d-flex align-items-center gap-2 flex-wrap mb-3">
                <code id="deployCmd" class="px-3 py-2 rounded" style="background:rgba(0,0,0,.4);color:#fde68a;font-size:.8rem;flex:1;min-width:0">
                    firebase deploy --only firestore:indexes --project loyal-road-395203
                </code>
                <button onclick="copiarCmd()" class="btn btn-sm fw-bold text-uppercase flex-shrink-0"
                        style="background:rgba(245,158,11,.15);color:#fbbf24;border:1px solid rgba(245,158,11,.35);font-size:11px;letter-spacing:.08em">
                    <i class="bi bi-clipboard" id="copyIcon"></i> Copiar
                </button>
            </div>
            <p class="mb-1 small" style="color:var(--sl-text-500)">Ou crie manualmente no Firebase Console:</p>
            <a href="https://console.firebase.google.com/project/loyal-road-395203/firestore/indexes"
               target="_blank" rel="noopener"
               class="btn btn-sm fw-bold text-uppercase"
               style="background:rgba(245,158,11,.1);color:#fbbf24;border:1px solid rgba(245,158,11,.25);font-size:11px;letter-spacing:.08em">
                <i class="bi bi-box-arrow-up-right me-1"></i> Abrir Firebase Console → Firestore → Índices
            </a>
        </div>
    </div>
    <script>
    function copiarCmd() {
        var txt = document.getElementById('deployCmd').textContent.trim();
        navigator.clipboard.writeText(txt).then(function() {
            var icon = document.getElementById('copyIcon');
            icon.className = 'bi bi-clipboard-check';
            setTimeout(function(){ icon.className = 'bi bi-clipboard'; }, 2000);
        });
    }
    </script>
    <% } %>

    <%# Header %>
    <div class="d-flex align-items-start justify-content-between gap-3 mb-4 flex-wrap">
        <div>
            <h1 class="fw-bolder text-white text-uppercase mb-1" style="font-size:1.3rem;letter-spacing:-.02em">
                Analytics de Créditos
            </h1>
            <p class="mb-0 small" style="color:var(--sl-text-500)">
                Consumo real de créditos Gemini por plano · Gerado em
                <span id="geradoEm"><%= new Date(analytics.gerado_em).toLocaleTimeString('pt-BR') %></span>
            </p>
        </div>
        <%# Filtro de período %>
        <div class="d-flex gap-1">
            <a href="/eu/analytics?dias=7"
               class="period-btn btn btn-sm fw-bold text-uppercase <%= dias == 7 ? 'active' : '' %>"
               style="font-size:10px;letter-spacing:.08em;background:var(--sl-bg-800);color:var(--sl-text-400);border:1px solid var(--sl-bg-800)">7d</a>
            <a href="/eu/analytics?dias=30"
               class="period-btn btn btn-sm fw-bold text-uppercase <%= dias == 30 || !dias ? 'active' : '' %>"
               style="font-size:10px;letter-spacing:.08em;background:var(--sl-bg-800);color:var(--sl-text-400);border:1px solid var(--sl-bg-800)">30d</a>
            <a href="/eu/analytics?dias=90"
               class="period-btn btn btn-sm fw-bold text-uppercase <%= dias == 90 ? 'active' : '' %>"
               style="font-size:10px;letter-spacing:.08em;background:var(--sl-bg-800);color:var(--sl-text-400);border:1px solid var(--sl-bg-800)">90d</a>
        </div>
    </div>

    <%
    var planosObj = analytics.por_plano || {};
    var planos    = Object.keys(planosObj);
    var totalCreditos    = planos.reduce(function(s,p){ return s + planosObj[p].total_creditos_debitados; }, 0);
    var totalInteracoes  = planos.reduce(function(s,p){ return s + planosObj[p].total_interacoes; }, 0);
    var totalUsuarios    = planos.reduce(function(s,p){ return s + planosObj[p].usuarios_ativos; }, 0);
    var mediaGlobal      = totalInteracoes > 0 ? (totalCreditos / totalInteracoes).toFixed(2) : 0;
    %>

    <%# KPI strip %>
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="kpi-card">
                <i class="bi bi-lightning-charge-fill mb-3" style="color:var(--sl-primary);font-size:1.1rem"></i>
                <p class="fw-bolder text-white mb-1" style="font-size:1.6rem;line-height:1" id="kpiCreditos">
                    <%= totalCreditos.toLocaleString('pt-BR') %>
                </p>
                <p class="mb-0 small" style="color:var(--sl-text-500)">Créditos debitados</p>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="kpi-card">
                <i class="bi bi-chat-dots-fill mb-3" style="color:#a78bfa;font-size:1.1rem"></i>
                <p class="fw-bolder text-white mb-1" style="font-size:1.6rem;line-height:1" id="kpiInteracoes">
                    <%= totalInteracoes.toLocaleString('pt-BR') %>
                </p>
                <p class="mb-0 small" style="color:var(--sl-text-500)">Interações totais</p>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="kpi-card">
                <i class="bi bi-people-fill mb-3" style="color:#34d399;font-size:1.1rem"></i>
                <p class="fw-bolder text-white mb-1" style="font-size:1.6rem;line-height:1" id="kpiUsuarios">
                    <%= totalUsuarios %>
                </p>
                <p class="mb-0 small" style="color:var(--sl-text-500)">Usuários com consumo</p>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="kpi-card">
                <i class="bi bi-graph-up mb-3" style="color:#fbbf24;font-size:1.1rem"></i>
                <p class="fw-bolder text-white mb-1" style="font-size:1.6rem;line-height:1" id="kpiMedia">
                    <%= mediaGlobal %>
                </p>
                <p class="mb-0 small" style="color:var(--sl-text-500)">Créditos / interação (média)</p>
            </div>
        </div>
    </div>

    <%# Tabela por plano %>
    <div class="section-card mb-4">
        <div class="px-4 py-3" style="border-bottom:1px solid var(--sl-bg-800)">
            <p class="section-label mb-0">Consumo por plano — últimos <%= dias %> dias</p>
        </div>

        <% if (planos.length === 0) { %>
        <div class="text-center py-5" style="color:var(--sl-text-500)">
            <i class="bi bi-inbox" style="font-size:2rem"></i>
            <p class="small mt-2 mb-0">Nenhum billing_log no período.</p>
        </div>
        <% } else { %>
        <div class="table-responsive">
        <table class="table an-table mb-0">
            <thead>
                <tr>
                    <th>Plano</th>
                    <th>Usuários ativos</th>
                    <th>Interações</th>
                    <th>Créditos debitados</th>
                    <th>Média / msg</th>
                    <th>Média / usuário</th>
                    <th>Ciclo do plano</th>
                    <th style="min-width:160px">% uso do ciclo</th>
                </tr>
            </thead>
            <tbody id="anTableBody">
            <% planos.forEach(function(plano) {
                var p           = planosObj[plano];
                var pct         = p.pct_uso_ciclo;
                var barColor    = pct >= 80 ? '#f87171' : pct >= 50 ? '#fbbf24' : '#34d399';
                var planClass   = 'plan-' + plano;
            %>
            <tr>
                <td>
                    <span class="plan-chip <%= planClass %>"><%= plano.toUpperCase() %></span>
                </td>
                <td class="text-white fw-bold"><%= p.usuarios_ativos %></td>
                <td><%= p.total_interacoes.toLocaleString('pt-BR') %></td>
                <td class="text-white fw-bold">
                    <%= p.total_creditos_debitados.toLocaleString('pt-BR') %>
                    <span class="d-block" style="font-size:.68rem;color:var(--sl-text-500);font-weight:500">
                        ~<%= (p.total_tokens/1000).toFixed(0) %>K tokens
                    </span>
                </td>
                <td>
                    <span style="color:<%= p.media_creditos_por_interacao >= 8 ? '#f87171' : 'var(--sl-text-300)' %>">
                        <%= p.media_creditos_por_interacao %>
                    </span>
                    <span style="font-size:.68rem;color:var(--sl-text-500)">
                        (~<%= p.media_tokens_por_interacao.toLocaleString('pt-BR') %> tokens)
                    </span>
                </td>
                <td>
                    <%= p.media_creditos_por_usuario.toLocaleString('pt-BR') %>
                    <span style="font-size:.68rem;color:var(--sl-text-500)"> créditos/ciclo</span>
                </td>
                <td style="color:var(--sl-text-400)">
                    <%= p.creditos_ciclo.toLocaleString('pt-BR') %>
                </td>
                <td>
                    <div class="d-flex align-items-center gap-2">
                        <div class="bar-bg flex-grow-1">
                            <div class="bar-fill" style="width:<%= Math.min(pct,100) %>%;background:<%= barColor %>"></div>
                        </div>
                        <span style="font-size:.75rem;font-weight:700;color:<%= barColor %>;min-width:38px;text-align:right">
                            <%= pct %>%
                        </span>
                    </div>
                </td>
            </tr>
            <% }); %>
            </tbody>
        </table>
        </div>
        <% } %>
    </div>

    <%# Cards de eficiência por plano %>
    <% if (planos.length > 0) { %>
    <div class="section-card mb-4">
        <div class="px-4 py-3" style="border-bottom:1px solid var(--sl-bg-800)">
            <p class="section-label mb-0">Eficiência de créditos — diagnóstico</p>
        </div>
        <div class="row g-0">
        <% planos.forEach(function(plano, idx) {
            var p        = planosObj[plano];
            var pct      = p.pct_uso_ciclo;
            var status, statusColor, statusMsg;
            if (pct === 0) {
                status = 'Sem dados'; statusColor = 'var(--sl-text-500)';
                statusMsg = 'Nenhum consumo neste período.';
            } else if (pct < 20) {
                status = 'Subutilizado'; statusColor = '#34d399';
                statusMsg = 'Usuários usam pouco — podem estar churning ou ainda explorando.';
            } else if (pct < 60) {
                status = 'Saudável'; statusColor = '#38bdf8';
                statusMsg = 'Consumo equilibrado. Ciclo bem dimensionado.';
            } else if (pct < 85) {
                status = 'Alto uso'; statusColor = '#fbbf24';
                statusMsg = 'Uso elevado — usuários engajados. Verificar se estão satisfeitos.';
            } else {
                status = 'Crítico'; statusColor = '#f87171';
                statusMsg = 'Usuários consumindo >85% do ciclo. Considere aumentar cota.';
            }
        %>
        <div class="col-12 col-md-6 col-xl-3 px-4 py-3"
             style="<%= idx < planos.length - 1 ? 'border-right:1px solid var(--sl-bg-800)' : '' %>">
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="plan-chip plan-<%= plano %>"><%= plano.toUpperCase() %></span>
                <span style="font-size:.7rem;font-weight:700;color:<%= statusColor %>"><%= status %></span>
            </div>
            <p class="fw-bolder text-white mb-1" style="font-size:1.3rem">
                <%= p.media_creditos_por_usuario.toLocaleString('pt-BR') %>
                <span style="font-size:.75rem;font-weight:500;color:var(--sl-text-500)">/ <%= p.creditos_ciclo.toLocaleString('pt-BR') %></span>
            </p>
            <p class="mb-0" style="font-size:.7rem;color:var(--sl-text-500);line-height:1.5"><%= statusMsg %></p>
        </div>
        <% }); %>
        </div>
    </div>
    <% } %>

    <p class="text-center small" style="color:var(--sl-text-500)">
        Auto-refresh a cada 60s · Período: últimos <%= analytics.periodo_dias %> dias ·
        Última atualização: <span id="lastUpdate"><%= new Date(analytics.gerado_em).toLocaleTimeString('pt-BR') %></span>
    </p>

</div>
</main>

<script>
(function () {
    'use strict';

    var DIAS = <%= dias %>;

    function fmt(n) { return Number(n).toLocaleString('pt-BR'); }

    async function refresh() {
        try {
            var r  = await fetch('/eu/api/analytics/creditos?dias=' + DIAS);
            if (!r.ok) return;
            var d  = await r.json();

            var pp = d.por_plano || {};
            var totalC = 0, totalI = 0, totalU = 0;
            for (var pl in pp) {
                totalC += pp[pl].total_creditos_debitados;
                totalI += pp[pl].total_interacoes;
                totalU += pp[pl].usuarios_ativos;
            }
            var media = totalI > 0 ? (totalC / totalI).toFixed(2) : 0;

            document.getElementById('kpiCreditos').textContent   = fmt(totalC);
            document.getElementById('kpiInteracoes').textContent = fmt(totalI);
            document.getElementById('kpiUsuarios').textContent   = totalU;
            document.getElementById('kpiMedia').textContent      = media;

            // Atualiza linhas da tabela
            var tbody = document.getElementById('anTableBody');
            if (tbody) {
                var rows = tbody.querySelectorAll('tr');
                rows.forEach(function (row) {
                    var chip  = row.querySelector('.plan-chip');
                    if (!chip) return;
                    var plano = chip.textContent.trim().toLowerCase();
                    var p     = pp[plano];
                    if (!p) return;
                    var cells = row.querySelectorAll('td');
                    if (cells[1]) cells[1].innerHTML = '<strong class="text-white">' + p.usuarios_ativos + '</strong>';
                    if (cells[2]) cells[2].textContent = fmt(p.total_interacoes);
                    if (cells[3]) cells[3].innerHTML =
                        '<strong class="text-white">' + fmt(p.total_creditos_debitados) + '</strong>' +
                        '<span class="d-block" style="font-size:.68rem;color:var(--sl-text-500);font-weight:500">~' +
                        (p.total_tokens/1000).toFixed(0) + 'K tokens</span>';
                    if (cells[4]) cells[4].innerHTML =
                        '<span style="color:' + (p.media_creditos_por_interacao >= 8 ? '#f87171' : 'var(--sl-text-300)') + '">' +
                        p.media_creditos_por_interacao + '</span>' +
                        '<span style="font-size:.68rem;color:var(--sl-text-500)"> (~' +
                        fmt(p.media_tokens_por_interacao) + ' tokens)</span>';
                    if (cells[5]) cells[5].innerHTML =
                        fmt(p.media_creditos_por_usuario) +
                        '<span style="font-size:.68rem;color:var(--sl-text-500)"> créditos/ciclo</span>';
                    if (cells[7]) {
                        var pct = p.pct_uso_ciclo;
                        var cor = pct >= 80 ? '#f87171' : pct >= 50 ? '#fbbf24' : '#34d399';
                        cells[7].innerHTML =
                            '<div class="d-flex align-items-center gap-2">' +
                            '<div class="bar-bg flex-grow-1"><div class="bar-fill" style="width:' + Math.min(pct,100) + '%;background:' + cor + '"></div></div>' +
                            '<span style="font-size:.75rem;font-weight:700;color:' + cor + ';min-width:38px;text-align:right">' + pct + '%</span>' +
                            '</div>';
                    }
                });
            }

            document.getElementById('lastUpdate').textContent =
                new Date(d.gerado_em).toLocaleTimeString('pt-BR');
        } catch (e) { /* silencioso */ }
    }

    setTimeout(function loop() {
        refresh();
        setTimeout(loop, 60000);
    }, 60000);

}());
</script>

</body>
</html>
