<style>
/* ── Hero animations ───────────────────────────────────────────────── */
@keyframes heroFloat   { 0%,100%{transform:translateY(0)}  50%{transform:translateY(-8px)} }
@keyframes compileFlash{ 0%,100%{opacity:1}                50%{opacity:.4}                 }
@keyframes cursorBlink { 0%,100%{opacity:1}                50%{opacity:0}                  }
.hero-float    { animation: heroFloat    6s ease-in-out infinite; }
.compile-pulse { animation: compileFlash 1.4s ease-in-out infinite; }
.cursor        { animation: cursorBlink  1s step-end infinite; }
.chip-item { transition: border-color .2s, background .2s; }
.chip-item:hover { border-color:rgba(56,189,248,.4)!important; background:rgba(56,189,248,.06)!important; }
.feat-card:hover { border-color:rgba(56,189,248,.25)!important; box-shadow:0 0 30px -10px rgba(56,189,248,.2); }

/* [data-hero="panel"] (desktop, d-lg-flex) recebe transform contínuo pra
   sempre via GSAP (flutuação, ver home-hero-anim.js) e tem box-shadow
   duplo pesado (glow desfocado) — sem will-change o navegador tende a
   repintar a sombra a cada frame da animação infinita em vez de só
   compositar. */
[data-hero="panel"] { will-change: transform; }

/* ── Terminal chat ─────────────────────────────────────────────────── */
@keyframes termFade  { to { opacity:1; transform:translateY(0); } }
.term-line { opacity:0; transform:translateY(5px); animation:termFade .28s ease forwards; }
@keyframes thinkDot  { 0%,60%,100%{opacity:.2;transform:translateY(0)} 30%{opacity:1;transform:translateY(-3px)} }
.think-dot:nth-child(1){ animation:thinkDot 1.1s ease-in-out       infinite; }
.think-dot:nth-child(2){ animation:thinkDot 1.1s ease-in-out  .15s  infinite; }
.think-dot:nth-child(3){ animation:thinkDot 1.1s ease-in-out  .30s  infinite; }

/* ── Demo indicator dots ───────────────────────────────────────────── */
.demo-dot { width:6px;height:6px;border-radius:50%;background:rgba(255,255,255,.15);transition:all .3s;cursor:pointer;flex-shrink:0; }
.demo-dot.active { background:#38bdf8;width:18px;border-radius:3px; }

/* ── Cap items (JS sets opacity/transform for graceful degradation) ── */
.cap-item { transition: border-color .2s, background .2s; }
.cap-item:hover { border-color:rgba(56,189,248,.2)!important; background:rgba(15,23,42,.8)!important; }
.cap-icon { transition:transform .2s; }
.cap-item:hover .cap-icon { transform:scale(1.1); }

/* ── Ticker ────────────────────────────────────────────────────────── */
@keyframes tickerMove { from{transform:translateX(0)} to{transform:translateX(-50%)} }
.ticker-track { display:flex; width:max-content; animation:tickerMove 32s linear infinite; }
.ticker-wrap:hover .ticker-track { animation-play-state:paused; }

/* ── Chat fade transition ──────────────────────────────────────────── */
#iaChatArea { transition:opacity .35s ease; }

/* ── Hero clip-mask (revelação linha-a-linha) ──────────────────────── */
/* padding-bottom no mask: (1) cria respiro visual entre as duas linhas
   do h1 em todos os tamanhos, (2) evita corte de descenders no
   overflow:hidden durante a animação. */
.hero-mask        { display:block; padding-bottom:0.18em; }
.hero-mask__inner { display:block; }

/* ── Anti-FOUC ─────────────────────────────────────────────────────────
   Estados iniciais aplicados SÓ quando .js-anim está no <html> (armado
   por script síncrono antes do paint). Sem JS de animação, sem GSAP ou
   com prefers-reduced-motion → a classe nunca entra/é removida e tudo
   aparece imediatamente. O GSAP assume o controlo via estilos inline. */
.js-anim .hero-mask                       { overflow:hidden; }
.js-anim .hero-mask__inner                { transform:translateY(110%); }
.js-anim [data-hero="badge"],
.js-anim [data-hero="lead"],
.js-anim [data-hero="cta"],
.js-anim [data-hero="trust"],
.js-anim [data-hero="panel"]              { opacity:0; }
.js-anim [data-hero="chips"] .chip-item   { opacity:0; }
</style>
<script>
/* Anti-FOUC: arma os estados iniciais do hero antes de o browser pintar.
   Removido por /js/home-hero-anim.js assim que o GSAP assume — ou no
   failsafe abaixo, caso o script de animação não chegue a correr. */
(function () {
    var mq = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)');
    if (mq && mq.matches) return;                       // respeita menos movimento
    document.documentElement.classList.add('js-anim');
    window.addEventListener('load', function () {
        setTimeout(function () {                          // failsafe: revela se nada assumiu
            document.documentElement.classList.remove('js-anim');
        }, 1500);
    });
})();
</script>

