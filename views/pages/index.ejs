<script>
(function() {
    'use strict';

    /* ── Terminal chat demo ──────────────────────────────────────────── */
    var DEMOS = [
        {
            user: 'Corrija o XML quebrado do meu template',
            lines: [
                { t: 'text',  c: 'Analisando estrutura XML do template...' },
                { t: 'warn',  c: 'b:section \'main\' sem atributo maxwidgets' },
                { t: 'warn',  c: 'b:includable id duplicado no widget Footer' },
                { t: 'ok',    c: '2 erros corrigidos · compilando...' },
                { t: 'code',  c: "&lt;b:section id='main' maxwidgets='3'\n  showaddelement='yes'&gt;" }
            ]
        },
        {
            user: 'Adicione SEO completo ao meu blog',
            lines: [
                { t: 'text',  c: 'Gerando meta tags e Open Graph...' },
                { t: 'ok',    c: 'og:title, og:description, og:image — ok' },
                { t: 'ok',    c: 'Schema JSON-LD: BlogPosting — ok' },
                { t: 'ok',    c: 'Twitter Card e canonical URL — ok' },
                { t: 'code',  c: "&lt;meta property='og:title'\n  content='&lt;data:blog.pageTitle/&gt;'&gt;" }
            ]
        },
        {
            user: 'Crie widgets AdSense para sidebar e header',
            lines: [
                { t: 'text',  c: 'Calculando posições otimizadas para CPM...' },
                { t: 'ok',    c: '300×250 sidebar — acima do fold' },
                { t: 'ok',    c: '728×90 leaderboard — header' },
                { t: 'ok',    c: 'Responsive unit — entre posts' },
                { t: 'code',  c: "&lt;b:widget id='AdSense1'\n  type='AdSense' locked='false'&gt;" }
            ]
        },
        {
            user: 'Gere menu responsivo mobile para o blog',
            lines: [
                { t: 'text',  c: 'Detectando breakpoints do template...' },
                { t: 'ok',    c: 'Hamburger menu nativo construído' },
                { t: 'ok',    c: 'CSS @media queries inseridos' },
                { t: 'ok',    c: 'Toggle JS sem dependências externas' },
                { t: 'code',  c: '@media (max-width:768px) {\n  .nav-desktop { display:none; }\n  .nav-mobile  { display:block; } }' }
            ]
        },
        {
            user: 'Adicione dark mode automático ao template',
            lines: [
                { t: 'text',  c: 'Detectando variáveis de cor do template...' },
                { t: 'ok',    c: 'Paleta escura gerada (22 variáveis CSS)' },
                { t: 'ok',    c: 'prefers-color-scheme configurado' },
                { t: 'ok',    c: 'Toggle manual com localStorage' },
                { t: 'code',  c: '@media (prefers-color-scheme: dark) {\n  :root { --bg:#0a0f1e;\n    --text:#e2e8f0; } }' }
            ]
        }
    ];

    var chatArea  = document.getElementById('iaChatArea');
    var inputEl   = document.getElementById('iaInputText');
    var indicators= document.getElementById('demoIndicators');
    if (!chatArea || !inputEl || !indicators) return;

    /* build indicator dots */
    DEMOS.forEach(function(_, i) {
        var d = document.createElement('span');
        d.className = 'demo-dot' + (i === 0 ? ' active' : '');
        d.addEventListener('click', function() { startDemo(i); });
        indicators.appendChild(d);
    });

    var timers = [];
    function sched(fn, ms) { timers.push(setTimeout(fn, ms)); }
    function clearAll() { timers.forEach(clearTimeout); timers = []; }

    function av() {
        return '<div style="width:28px;height:28px;border-radius:6px;background:linear-gradient(135deg,#818cf8,#38bdf8);flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:9px;font-weight:700;color:#fff;font-family:monospace">IA</div>';
    }

    function addMsg(type, content) {
        var el = document.createElement('div');
        el.className = 'term-line mb-2';
        if (type === 'user') {
            el.className += ' d-flex justify-content-end';
            el.innerHTML = '<div class="rounded-3 px-3 py-2" style="background:rgba(99,102,241,.1);border:1px solid rgba(99,102,241,.18);max-width:85%"><p class="mb-0" style="font-size:12.5px;color:rgba(255,255,255,.7)">' + content + '</p></div>';
        } else if (type === 'thinking') {
            el.id = 'thinkEl';
            el.innerHTML = '<div class="d-flex gap-2 align-items-center">' + av() + '<div class="rounded-3 px-3 py-2" style="background:rgba(129,140,248,.07);border:1px solid rgba(129,140,248,.12)"><span class="think-dot" style="display:inline-block;width:5px;height:5px;background:#818cf8;border-radius:50%;margin:0 2px"></span><span class="think-dot" style="display:inline-block;width:5px;height:5px;background:#818cf8;border-radius:50%;margin:0 2px"></span><span class="think-dot" style="display:inline-block;width:5px;height:5px;background:#818cf8;border-radius:50%;margin:0 2px"></span></div></div>';
        } else if (type === 'text') {
            el.innerHTML = '<div class="d-flex gap-2 align-items-start">' + av() + '<div class="rounded-3 px-3 py-2" style="background:rgba(129,140,248,.07);border:1px solid rgba(129,140,248,.12);max-width:90%"><p class="mb-0" style="font-size:12.5px;color:var(--sl-text-300);line-height:1.6">' + content + '</p></div></div>';
        } else if (type === 'ok') {
            el.innerHTML = '<div class="d-flex gap-2 align-items-center ms-5 ps-2"><span style="color:#4ade80;font-size:12px">✓</span><span style="font-size:12px;color:rgba(255,255,255,.6)">' + content + '</span></div>';
        } else if (type === 'warn') {
            el.innerHTML = '<div class="d-flex gap-2 align-items-center ms-5 ps-2"><span style="color:#fbbf24;font-size:12px">⚠</span><span style="font-size:12px;color:rgba(255,255,255,.55)">' + content + '</span></div>';
        } else if (type === 'code') {
            el.innerHTML = '<div class="ms-5 ps-2 mt-1"><div class="rounded-3 overflow-hidden" style="background:#050a14;border:1px solid rgba(255,255,255,.07)"><pre class="mb-0 px-3 py-2" style="font-size:11px;color:#50fa7b;line-height:1.7;font-family:monospace;white-space:pre">' + content + '</pre></div></div>';
        }
        chatArea.appendChild(el);
        chatArea.scrollTop = chatArea.scrollHeight;
    }

    function typeInInput(text, done) {
        var i = 0;
        inputEl.textContent = '';
        function step() {
            inputEl.textContent = text.slice(0, ++i);
            if (i < text.length) sched(step, 26);
            else if (done) sched(done, 180);
        }
        step();
    }

    function startDemo(idx) {
        clearAll();
        chatArea.innerHTML = '';
        inputEl.textContent = '';

        /* update dots */
        document.querySelectorAll('.demo-dot').forEach(function(d, i) {
            d.classList.toggle('active', i === idx);
        });

        var demo = DEMOS[idx];
        var t = 0;

        /* 1 — type user message in input bar */
        sched(function() {
            typeInInput(demo.user, function() {
                /* 2 — move to chat */
                inputEl.textContent = '';
                addMsg('user', demo.user);

                /* 3 — thinking dots */
                sched(function() {
                    addMsg('thinking', '');

                    /* 4 — remove thinking, show IA lines */
                    sched(function() {
                        var th = document.getElementById('thinkEl');
                        if (th) th.remove();

                        demo.lines.forEach(function(line, i) {
                            sched(function() {
                                addMsg(line.t, line.c);
                            }, i * 370);
                        });

                        /* 5 — wait, then fade out and run next */
                        var fadeDelay = demo.lines.length * 370 + 2000;
                        sched(function() {
                            chatArea.style.opacity = '0';
                        }, fadeDelay);
                        sched(function() {
                            chatArea.style.opacity = '1';
                            chatArea.innerHTML = '';
                            startDemo((idx + 1) % DEMOS.length);
                        }, fadeDelay + 380);

                    }, 650);
                }, 300);
            });
        }, t + 400);
    }

    /* Espera a timeline de entrada do hero (GSAP, ver home-hero-anim.js)
       terminar antes de começar a demo — as duas animando ao mesmo tempo
       logo após o load é a causa real do travamento no desktop. Delay
       fixo (900ms) foi trocado por um evento, já que a duração real da
       timeline de entrada não é garantida.
       Rede de segurança: se home-hero-anim.js falhar ao carregar/executar
       por qualquer motivo, o evento nunca chega — o timeout garante que a
       demo começa mesmo assim. */
    var demoIniciado = false;
    function iniciarDemoUmaVez() {
        if (demoIniciado) return;
        demoIniciado = true;
        startDemo(0);
    }
    document.addEventListener('sl:hero-entrance-done', iniciarDemoUmaVez);
    sched(iniciarDemoUmaVez, 3000);

    /* ── IntersectionObserver: cap items ─────────────────────────────── */
    /* NOTA: os feature cards (.feat-card) são revelados via GSAP
       ScrollTrigger com scrub — ver /js/home-hero-anim.js. */
    var capItems = document.querySelectorAll('.cap-item');
    if ('IntersectionObserver' in window) {
        var capObs = new IntersectionObserver(function(entries) {
            entries.forEach(function(e) {
                if (e.isIntersecting) {
                    e.target.style.opacity = '1';
                    e.target.style.transform = 'translateX(0)';
                }
            });
        }, { threshold: 0.12, rootMargin: '0px 0px -20px 0px' });

        capItems.forEach(function(el, i) {
            el.style.opacity = '0';
            el.style.transform = 'translateX(28px)';
            el.style.transition = 'opacity .45s ease ' + (i * 48) + 'ms, transform .45s ease ' + (i * 48) + 'ms';
            capObs.observe(el);
        });
    }

})();
</script>

