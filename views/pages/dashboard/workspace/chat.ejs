<%- include('../../../partials/header') %>

<div class="sl-dash-wrapper" style="height:100dvh;overflow:hidden">

    <%- include('../../../partials/dashboard-sidebar', { activePage: 'workspace', user: user }) %>

    <main class="flex-grow-1 d-flex flex-column overflow-hidden">

        <%# Topbar mobile %>
        <div class="sl-topbar d-lg-none flex-shrink-0">
            <a href="/dashboard/workspace" class="btn btn-link p-1" style="color:var(--sl-text-400)" title="Voltar ao Workspace">
                <i class="bi bi-arrow-left" style="font-size:1.2rem"></i>
            </a>
            <span class="flex-grow-1 fw-black text-uppercase small" style="letter-spacing:0.05em">Editor do Workspace</span>
            <span class="badge rounded-pill fw-black text-uppercase"
                  style="font-size:8px;letter-spacing:0.08em;background:rgba(14,165,233,.15);color:var(--sl-primary)">IA</span>
            <button onclick="slHistoricoOpen()" class="btn btn-link p-1 ms-1" style="color:var(--sl-text-400)" title="Histórico de conversas">
                <i class="bi bi-clock-history" style="font-size:1.2rem"></i>
            </button>
        </div>

        <%# Área do chat %>
        <div id="sl-chat-area" class="flex-grow-1 d-flex flex-column p-0 p-md-3 p-lg-4" style="overflow:hidden;min-height:0">

            <%# Cabeçalho %>
            <div class="sl-chat-controls-bar d-flex align-items-center gap-3 mb-0 mb-lg-3 flex-shrink-0 px-3 px-lg-0 py-2 py-lg-0">
                <a href="/dashboard/workspace" class="d-none d-lg-flex align-items-center justify-content-center rounded-3 flex-shrink-0"
                   style="width:40px;height:40px;background:linear-gradient(135deg,rgba(14,165,233,.2),rgba(37,99,235,.2));border:1px solid rgba(14,165,233,.25)"
                   title="Voltar ao Workspace">
                    <i class="bi bi-arrow-left" style="color:var(--sl-primary);font-size:1.1rem"></i>
                </a>
                <div class="d-none d-lg-block">
                    <h1 class="fw-black text-uppercase mb-0 d-flex align-items-center gap-2" style="font-size:1.1rem;letter-spacing:-0.02em">
                        Editor do Workspace
                        <span class="badge rounded-pill fw-black text-uppercase"
                              style="font-size:8px;letter-spacing:0.08em;background:rgba(14,165,233,.15);color:var(--sl-primary)">IA</span>
                    </h1>
                    <% if (snapshot) { %>
                    <p class="mb-0 small d-flex align-items-center gap-1" style="color:var(--sl-text-400)">
                        <i class="bi bi-layers-fill" style="color:var(--sl-primary);font-size:.8rem"></i>
                        Template <strong style="color:var(--sl-text-main)"><%= snapshot.siteName || 'sem nome ainda' %></strong>
                        <span style="opacity:.5">·</span>
                        <span style="color:var(--sl-primary);font-size:.72rem"><%= snapshot.colorPreset || 'tech-blue' %></span>
                        <%= snapshot.manifesto ? 'carregado' : '(peça pra gerar pra começar)' %>
                    </p>
                    <% } else { %>
                    <p class="mb-0 small" style="color:var(--sl-text-400)">Nenhum template ainda — descreva o site que você quer criar</p>
                    <% } %>
                </div>
                <div class="ms-auto d-flex align-items-center gap-2 flex-shrink-0">
                    <%# Créditos Gemini — chat do Workspace é Gemini-only, sem seletor de modelo %>
                    <span id="sl-gemini-credits" class="d-none d-sm-flex align-items-center gap-1" style="font-size:.68rem;font-weight:700;color:var(--sl-text-400);font-variant-numeric:tabular-nums;white-space:nowrap">
                        <i class="bi bi-lightning-charge-fill" style="font-size:.58rem;color:#818cf8"></i>
                        <span id="sl-gemini-credits-val"><%= typeof creditosGemini !== 'undefined' ? creditosGemini.toLocaleString('pt-BR') : 0 %></span>
                        <span style="color:var(--sl-text-600);font-weight:400">/</span>
                        <span style="color:var(--sl-text-500)"><%= typeof creditosGeminiTotal !== 'undefined' ? creditosGeminiTotal.toLocaleString('pt-BR') : 0 %></span>
                    </span>
                    <button onclick="slHistoricoOpen()" class="btn btn-sm d-flex align-items-center gap-1"
                            style="font-size:.78rem;color:var(--sl-text-400);border:1px solid var(--bs-border-color);background:transparent;padding:4px 10px">
                        <i class="bi bi-clock-history" style="font-size:.85rem"></i>
                        <span class="d-none d-sm-inline">Histórico</span>
                    </button>
                    <button id="sl-chat-novo-btn" class="btn btn-sm d-flex align-items-center gap-1"
                            disabled
                            style="font-size:.78rem;color:var(--sl-text-400);border:1px solid var(--bs-border-color);background:transparent;padding:4px 10px">
                        <i class="bi bi-plus-circle" style="font-size:.85rem"></i>
                        <span class="d-none d-sm-inline">Nova conversa</span>
                    </button>
                </div>
            </div>

            <%# Card principal %>
            <div class="sl-card d-flex flex-column flex-grow-1" style="overflow:hidden;min-height:0;padding:0;margin-bottom:0">

                <%# Estado vazio / sugestões %>
                <div id="sl-chat-empty" class="flex-grow-1 d-flex flex-column align-items-center justify-content-center text-center p-3 p-md-4"
                     style="overflow-y:auto;min-height:0">
                    <div class="rounded-3 d-flex align-items-center justify-content-center mb-2 mb-md-3 flex-shrink-0"
                         style="width:48px;height:48px;background:linear-gradient(135deg,rgba(14,165,233,.15),rgba(37,99,235,.15));border:1px solid rgba(14,165,233,.2)">
                        <i class="bi bi-layers-fill" style="font-size:1.3rem;color:var(--sl-primary)"></i>
                    </div>
                    <% if (snapshot && snapshot.manifesto) { %>
                    <h2 class="fw-black mb-1" style="font-size:1rem;letter-spacing:-0.02em">O que você quer mudar?</h2>
                    <p class="small mb-3 d-none d-sm-block" style="color:var(--sl-text-400);max-width:320px;line-height:1.55">
                        Esse chat edita só o template que você já tem carregado aqui — cor, tipografia, textos, layout, CSS/JS.
                    </p>
                    <div class="d-flex flex-wrap gap-2 justify-content-center flex-shrink-0" style="max-width:460px">
                        <button class="sl-chat-suggestion">Trocar a cor principal do site</button>
                        <button class="sl-chat-suggestion">Mudar a tipografia</button>
                        <button class="sl-chat-suggestion d-none d-sm-inline-flex">Adicionar uma seção de FAQ</button>
                        <button class="sl-chat-suggestion d-none d-sm-inline-flex">Que fonte eu escolhi?</button>
                    </div>
                    <% } else { %>
                    <h2 class="fw-black mb-1" style="font-size:1rem;letter-spacing:-0.02em">Vamos criar seu template</h2>
                    <p class="small mb-3 d-none d-sm-block" style="color:var(--sl-text-400);max-width:320px;line-height:1.55">
                        Descreva o site que você quer — nicho, nome, estilo — e eu monto o template completo.
                    </p>
                    <div class="d-flex flex-wrap gap-2 justify-content-center flex-shrink-0" style="max-width:460px">
                        <button class="sl-chat-suggestion">Criar um blog sobre culinária</button>
                        <button class="sl-chat-suggestion">Criar um site de tecnologia e reviews</button>
                        <button class="sl-chat-suggestion d-none d-sm-inline-flex">Criar uma landing page de portfólio</button>
                    </div>
                    <% } %>
                </div>

                <%# Lista de mensagens %>
                <div id="sl-chat-messages-wrap" class="flex-grow-1 p-2 p-md-3"
                     style="overflow-y:auto;flex-direction:column;gap:10px;display:none;min-height:0;scroll-behavior:smooth">
                </div>

                <%# Área de input %>
                <div class="flex-shrink-0 px-3 py-3" style="border-top:1px solid var(--bs-border-color)">
                    <div class="sl-chat-input-area">
                        <textarea
                            id="sl-chat-input"
                            class="sl-chat-textarea"
                            placeholder="Descreva a mudança que você quer no template..."
                            rows="1"
                            maxlength="6000"
                        ></textarea>
                        <button id="sl-chat-send" class="sl-chat-send-btn" disabled aria-label="Enviar mensagem">
                            <i id="sl-chat-send-icon" class="bi bi-send-fill" style="font-size:.9rem"></i>
                        </button>
                    </div>
                    <p class="mb-0 mt-2 text-center d-none d-sm-block" style="font-size:.7rem;color:var(--sl-text-500)">
                        <kbd class="rounded px-1" style="font-size:.65rem;background:rgba(148,163,184,.1);border:1px solid var(--bs-border-color)">Enter</kbd>
                        enviar &nbsp;·&nbsp;
                        <kbd class="rounded px-1" style="font-size:.65rem;background:rgba(148,163,184,.1);border:1px solid var(--bs-border-color)">Shift+Enter</kbd>
                        nova linha
                    </p>
                </div>

            </div><%# /card %>

        </div><%# /chat area %>

    </main>
</div>

<%# ── Drawer histórico de conversas ──────────────────────────────────────── %>
<div id="sl-hist-overlay"
     style="display:none;position:fixed;inset:0;z-index:400;background:rgba(0,0,0,.55);backdrop-filter:blur(2px)"
     onclick="slHistoricoClose()"></div>

<div id="sl-hist-drawer"
     style="position:fixed;top:0;left:0;bottom:0;width:min(340px,92vw);z-index:401;
            background:var(--sl-bg-900);border-right:1px solid var(--sl-bg-800);
            transform:translateX(-100%);transition:transform .25s cubic-bezier(.4,0,.2,1);
            overflow:hidden;display:flex;flex-direction:column">

    <div class="d-flex align-items-center gap-2 px-3 py-3 flex-shrink-0"
         style="border-bottom:1px solid var(--sl-bg-800)">
        <i class="bi bi-clock-history" style="color:var(--sl-primary);font-size:1rem"></i>
        <span class="fw-black text-uppercase flex-grow-1" style="font-size:.85rem;letter-spacing:-.01em">Histórico</span>
        <button onclick="slHistoricoClose()"
                style="background:none;border:none;color:var(--sl-text-400);font-size:1.1rem;cursor:pointer;padding:2px;line-height:1">
            <i class="bi bi-x-lg"></i>
        </button>
    </div>

    <div id="sl-hist-list" style="flex:1;overflow-y:auto;padding:8px"></div>
</div>

<style>
.sl-hist-item {
    padding: 10px 12px;
    border-radius: 8px;
    cursor: pointer;
    margin-bottom: 4px;
    border: 1px solid transparent;
    transition: background .15s, border-color .15s;
}
.sl-hist-item:hover, .sl-hist-item:active {
    background: rgba(14,165,233,.08);
    border-color: rgba(14,165,233,.2);
}
.sl-hist-preview {
    font-size: .82rem;
    color: var(--sl-text-300);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.sl-hist-meta {
    font-size: .7rem;
    color: var(--sl-text-400);
    margin-top: 3px;
    display: flex;
    gap: 8px;
}
</style>

<%# Mermaid — renderiza blocos ```mermaid``` do chat como diagrama SVG. %>
<script src="https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.min.js"></script>

<script>
(function () {
    'use strict';

    if (window.mermaid) {
        mermaid.initialize({
            startOnLoad: false,
            securityLevel: 'strict',
            theme: document.documentElement.getAttribute('data-bs-theme') === 'dark' ? 'dark' : 'default',
        });
    }

    function mountMermaid(container) {
        if (!window.mermaid || !container) return;
        const nodes = container.querySelectorAll('.mermaid');
        if (!nodes.length) return;
        mermaid.run({ nodes: nodes }).catch(function (err) {
            console.error('[mermaid] falha ao renderizar diagrama:', err);
        });
    }

    const chatEmpty   = document.getElementById('sl-chat-empty');
    const chatWrap    = document.getElementById('sl-chat-messages-wrap');
    const chatInput   = document.getElementById('sl-chat-input');
    const chatSend    = document.getElementById('sl-chat-send');
    const chatIcon    = document.getElementById('sl-chat-send-icon');
    const chatNovoBtn = document.getElementById('sl-chat-novo-btn');

    let isLoading           = false;
    let messagesSent        = 0;
    let conversationHistory = [];
    let currentSessionId    = null;
    let statusEl            = null;
    let statusHistory       = [];
    let currentAbortController = null; // permite parar a geração em andamento

    const HIST_TYPE     = 'workspace-chat';
    const WS_SESSION_ID = '<%= wsSessionId %>';
    const WS_PROJETO_ID = '<%= wsProjetoId %>';

    // Mesmo mecanismo do botão "Ver Demo" da tela principal do Workspace
    // (/dashboard/workspace, wsVerDemo) — reaproveitado aqui pra dar uma
    // confirmação VISUAL de uma edição aplicada pelo chat, sem reintroduzir
    // um botão de download avulso na bolha (decisão antiga preservada).
    // Achado real (usuário relatou "chat só promete e diz que mudou"): sem
    // isso, a única confirmação de uma edição aplicada era texto — nada
    // distinguia visualmente uma mudança real de uma que não fez nada.
    async function slVerAlteracaoAplicada(preview) {
        if (!preview || !preview.xmlPath) return;
        try {
            var r = await fetch('/api/workspace/set-preview', {
                method:  'POST',
                headers: { 'Content-Type': 'application/json' },
                body:    JSON.stringify({
                    xmlPath:     preview.xmlPath,
                    gcPath:      preview.gcPath || '',
                    siteName:    preview.siteName || '',
                    colorPreset: preview.colorPreset || '',
                    nichoTema:   preview.nichoTema || '',
                }),
            });
            if (!r.ok) { alert('Não foi possível carregar o preview.'); return; }
            window.open('/dashboard/preview/session', '_blank');
        } catch (e) { alert('Falha de conexão.'); }
    }

    // ── Modelo — chat do Workspace é Gemini-only, sem seletor ──────────────
    const currentModel = { id: 'gemini-flash', label: 'Gemini Flash', icon: '<i class="bi bi-stars" style="color:#818cf8"></i>' };
    const geminiCreditsVal = document.getElementById('sl-gemini-credits-val');

    function debitarContadorUI(tokens) {
        if (!tokens || !tokens.total || !geminiCreditsVal) return;
        const debited = Math.ceil(tokens.total / 1000);
        var cur = parseInt(geminiCreditsVal.textContent.replace(/\./g,'').replace(/,/g,'').replace(/\s/g,'') || '0', 10);
        geminiCreditsVal.textContent = Math.max(0, cur - debited).toLocaleString('pt-BR');
    }

    // ── Copy code — global pois é chamado via onclick no HTML renderizado
    window.slCopyCode = function (uid) {
        const pre  = document.getElementById(uid);
        if (!pre) return;
        const code = pre.querySelector('code');
        const text = code ? code.textContent : pre.textContent;
        navigator.clipboard.writeText(text).then(function () {
            const icon = document.getElementById('slcbi_' + uid);
            if (icon) {
                icon.className = 'bi bi-check2';
                setTimeout(function () { icon.className = 'bi bi-clipboard'; }, 2000);
            }
        }).catch(function () {
            const ta = document.createElement('textarea');
            ta.value = text;
            ta.style.cssText = 'position:fixed;opacity:0';
            document.body.appendChild(ta);
            ta.select();
            document.execCommand('copy');
            document.body.removeChild(ta);
        });
    };

    // ── Markdown → HTML seguro com suporte a blocos de código
    function renderMarkdown(raw) {
        let html = raw
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');

        const blocks = [];
        html = html.replace(/```(\w*)\r?\n?([\s\S]*?)```/g, function (_, lang, code) {
            const idx = blocks.length;
            blocks.push({ lang: lang || 'code', code: code.replace(/\r?\n$/, '') });
            return '\x00CB' + idx + '\x00';
        });

        html = html.replace(/\*\*([^*\n]+)\*\*/g, '<strong>$1</strong>');
        html = html.replace(/\*([^*\n]+)\*/g,     '<em>$1</em>');
        html = html.replace(/`([^`\n]+)`/g,
            '<code style="font-family:monospace;font-size:.85em;background:rgba(148,163,184,.12);padding:1px 5px;border-radius:3px">$1</code>');
        html = html.replace(/^[\-•]\s+(.+)$/gm, '<li>$1</li>');
        html = html.replace(/(<li>.*<\/li>)/s, '<ul style="margin:.4em 0 .4em 1.1em;padding:0">$1</ul>');
        html = html.replace(/\n/g, '<br>');

        html = html.replace(/\x00CB(\d+)\x00/g, function (_, idx) {
            const b = blocks[parseInt(idx)];
            if (b.lang.toLowerCase() === 'mermaid') {
                return '<div class="sl-mermaid-block"><div class="mermaid">' + b.code + '</div></div>';
            }
            const uid = 'slcb_' + Math.random().toString(36).slice(2, 8);
            return '<div class="sl-code-block">' +
                '<div class="sl-code-header">' +
                    '<span class="sl-code-lang">' + b.lang + '</span>' +
                    '<button class="sl-code-copy-btn" type="button" onclick="slCopyCode(\'' + uid + '\')" aria-label="Copiar">' +
                        '<i class="bi bi-clipboard" id="slcbi_' + uid + '"></i><span>Copiar</span>' +
                    '</button>' +
                '</div>' +
                '<pre class="sl-code-pre" id="' + uid + '"><code>' + b.code + '</code></pre>' +
            '</div>';
        });

        return html;
    }

    function resizeInput() {
        chatInput.style.height = 'auto';
        chatInput.style.height = Math.min(chatInput.scrollHeight, 120) + 'px';
        // Durante o streaming o botão fica sempre habilitado (vira "parar") —
        // só reflete o conteúdo do input quando não está gerando.
        if (!isLoading) chatSend.disabled = chatInput.value.trim().length === 0;
    }

    function revealMessages() {
        if (messagesSent === 0) {
            chatEmpty.classList.add('d-none');
            chatWrap.style.display = 'flex';
            chatNovoBtn.disabled   = false;
        }
        messagesSent++;
    }

    function showStatus(label) {
        if (messagesSent === 0) {
            chatEmpty.classList.add('d-none');
            chatWrap.style.display = 'flex';
        }
        statusHistory.push(label);
        if (!statusEl) {
            statusEl = document.createElement('div');
            statusEl.className = 'sl-status-wrap';
            chatWrap.appendChild(statusEl);
        }
        const modelIcon = currentModel.icon || '<i class="bi bi-stars"></i>';
        statusEl.innerHTML = statusHistory.slice(0, -1).map(function (l) {
            return '<div class="sl-status-pill sl-status-past">' +
                '<span class="sl-status-pill-icon">' + modelIcon + '</span>' +
                '<span>' + l + '</span>' +
            '</div>';
        }).join('') +
        '<div class="sl-status-pill">' +
            '<div class="sl-status-scan"></div>' +
            '<span class="sl-status-pill-icon">' + modelIcon + '</span>' +
            '<span>' + label + '</span>' +
            '<span class="sl-status-dots"><span></span><span></span><span></span></span>' +
        '</div>';
        chatWrap.scrollTop = chatWrap.scrollHeight;
    }

    function hideStatus() {
        if (statusEl) { statusEl.remove(); statusEl = null; }
    }

    function createStreamBubble() {
        revealMessages();
        const row = document.createElement('div');
        row.className = 'sl-msg-row assistant';

        const header = document.createElement('div');
        header.className = 'sl-msg-header';
        header.innerHTML = (currentModel.icon || '') + ' ' + currentModel.label;

        const content = document.createElement('div');
        content.className = 'sl-msg-content';

        const textSpan = document.createElement('span');
        textSpan.className = 'sl-stream-text';
        const cursor   = document.createElement('span');
        cursor.className = 'sl-stream-cursor';
        content.appendChild(textSpan);
        content.appendChild(cursor);

        row.appendChild(header);
        row.appendChild(content);
        chatWrap.appendChild(row);
        chatWrap.scrollTop = chatWrap.scrollHeight;
        return { bubble: row, textSpan, cursor, content };
    }

    function addBubble(role, content) {
        revealMessages();
        const row = document.createElement('div');
        row.className = 'sl-msg-row ' + role;
        const msgContent = document.createElement('div');
        msgContent.className = 'sl-msg-content';
        if (role === 'assistant') {
            const header = document.createElement('div');
            header.className = 'sl-msg-header';
            header.innerHTML = (currentModel.icon || '') + ' ' + currentModel.label;
            row.appendChild(header);
            msgContent.innerHTML = renderMarkdown(content);
            mountMermaid(msgContent);
        } else {
            msgContent.textContent = content;
        }
        row.appendChild(msgContent);
        chatWrap.appendChild(row);
        chatWrap.scrollTop = chatWrap.scrollHeight;
    }

    function appendMsgFooter(row, plainText, stepCount) {
        const footer = document.createElement('div');
        footer.className = 'sl-msg-footer';
        if (stepCount > 0) {
            footer.innerHTML =
                '<span class="sl-msg-sources">' +
                    '<i class="bi bi-lightning-charge-fill" style="font-size:.6rem;color:#818cf8"></i>' +
                    stepCount + ' ' + (stepCount === 1 ? 'etapa' : 'etapas') +
                '</span>';
        }
        const copyBtn = document.createElement('button');
        copyBtn.type = 'button';
        copyBtn.className = 'sl-msg-copy-btn';
        copyBtn.innerHTML = '<i class="bi bi-clipboard" style="font-size:.7rem"></i> Copiar';
        copyBtn.addEventListener('click', function () {
            navigator.clipboard.writeText(plainText).then(function () {
                copyBtn.innerHTML = '<i class="bi bi-check2" style="font-size:.7rem"></i> Copiado';
                setTimeout(function () {
                    copyBtn.innerHTML = '<i class="bi bi-clipboard" style="font-size:.7rem"></i> Copiar';
                }, 2000);
            }).catch(function () {
                const ta = document.createElement('textarea');
                ta.value = plainText;
                ta.style.cssText = 'position:fixed;opacity:0';
                document.body.appendChild(ta);
                ta.select();
                document.execCommand('copy');
                document.body.removeChild(ta);
            });
        });
        footer.appendChild(copyBtn);
        row.appendChild(footer);
    }

    function setLoading(state) {
        isLoading = state;
        // Durante a geração o botão vira "parar" — fica sempre habilitado
        // (não depende de ter texto no input); fora disso, volta a exigir
        // texto pra habilitar o envio.
        chatSend.disabled      = state ? false : chatInput.value.trim().length === 0;
        chatIcon.className     = state ? 'bi bi-stop-fill' : 'bi bi-send-fill';
        chatIcon.style.fontSize = '.9rem';
        chatSend.setAttribute('aria-label', state ? 'Parar geração' : 'Enviar mensagem');
    }

    function pararGeracao() {
        if (currentAbortController) currentAbortController.abort();
    }

    function slChatNovo() {
        if (isLoading) return;
        conversationHistory = [];
        messagesSent        = 0;
        currentSessionId    = null;
        statusEl            = null;
        statusHistory       = [];
        chatWrap.innerHTML  = '';
        chatWrap.style.display  = 'none';
        chatEmpty.classList.remove('d-none');
        chatInput.value         = '';
        chatInput.style.height  = 'auto';
        chatSend.disabled       = true;
        chatNovoBtn.disabled    = true;
    }

    async function slChatSend() {
        const msg = chatInput.value.trim();
        if (!msg || isLoading) return;

        setLoading(true);
        statusHistory = [];
        chatInput.value = '';
        chatInput.style.height = 'auto';

        conversationHistory.push({ role: 'user', content: msg });
        addBubble('user', msg);

        let bubble = null, textSpan = null, cursor = null, streamContent = null;
        let streamText = '';
        let renderedText = ''; // texto já flushado em spans .sl-chunk — nunca reescrito, só acrescido
        let codeGenPill = null;
        let pendingPatch = null;

        const controller = new AbortController();
        currentAbortController = controller;

        try {
            const resp = await fetch('/dashboard/workspace/chat/stream', {
                method:  'POST',
                headers: { 'Content-Type': 'application/json' },
                // slice(0, -1) remove a própria mensagem atual (empurrada em conversationHistory.push
                // logo acima, pra já renderizar a bolha) antes de enviar — senão o backend recebe o
                // mesmo texto duas vezes: uma como último item de "history", outra em "message". O
                // Gemini via chat.sendMessage() enxerga isso como dois turnos "user" consecutivos
                // idênticos e reage de forma bizarra (ex: "você repetiu X", ou lê "4" como "44").
                body:    JSON.stringify({ message: msg, history: conversationHistory.slice(0, -1).slice(-20), sessionId: currentSessionId, model: currentModel.id, wsSessionId: WS_SESSION_ID, wsProjetoId: WS_PROJETO_ID }),
                signal:  controller.signal,
            });

            if (!resp.ok) {
                conversationHistory.pop();
                hideStatus();
                if (resp.status === 401) { addBubble('assistant', 'Sessão expirada. Recarregue a página e faça login novamente.'); return; }
                if (resp.status === 429) { addBubble('assistant', 'Limite de mensagens atingido. Aguarde antes de continuar.'); return; }
                if (resp.status === 402) {
                    const err402 = await resp.json().catch(function () { return {}; });
                    var msg402 = err402.error || err402.erro || 'Seus créditos acabaram. Acesse /dashboard/upgrade para renovar.';
                    addBubble('assistant', '⚠️ ' + msg402);
                    return;
                }
                const err = await resp.json().catch(function () { return {}; });
                addBubble('assistant', err.error || err.erro || 'Erro ao processar a mensagem. Tente novamente.');
                return;
            }

            const reader  = resp.body.getReader();
            const decoder = new TextDecoder('utf-8');
            let buffer    = '';

            outer: while (true) {
                const { done, value } = await reader.read();
                if (done) break;

                buffer += decoder.decode(value, { stream: true });

                let idx;
                while ((idx = buffer.indexOf('\n\n')) !== -1) {
                    const block = buffer.slice(0, idx);
                    buffer      = buffer.slice(idx + 2);
                    const dLine = block.match(/^data: (.+)$/m);
                    if (!dLine) continue;

                    let event;
                    try { event = JSON.parse(dLine[1]); } catch (_) { continue; }

                    if (event.type === 'status') {
                        showStatus(event.label);

                    } else if (event.type === 'chunk') {
                        hideStatus();
                        if (!bubble) {
                            const s = createStreamBubble();
                            bubble = s.bubble; textSpan = s.textSpan; cursor = s.cursor; streamContent = s.content;
                        }
                        streamText += event.text;

                        var displayText = streamText;
                        var markerIdx = streamText.indexOf('[[TEMPLATE:');
                        if (markerIdx !== -1) {
                            displayText = streamText.slice(0, markerIdx).trimEnd();
                        }

                        var openFences = (displayText.match(/```/g) || []).length;
                        var visibleTarget;
                        if (openFences % 2 !== 0) {
                            var lastFencePos = displayText.lastIndexOf('```');
                            var textBefore   = displayText.slice(0, lastFencePos).trimEnd();
                            var fenceHeader  = displayText.slice(lastFencePos).match(/```(\w*)/);
                            var codeLang     = (fenceHeader && fenceHeader[1]) ? fenceHeader[1] : 'código';
                            visibleTarget = textBefore;
                            if (!codeGenPill) {
                                codeGenPill = document.createElement('div');
                                codeGenPill.className = 'sl-code-gen-pill';
                                streamContent.insertBefore(codeGenPill, cursor);
                            }
                            codeGenPill.innerHTML =
                                '<div class="sl-status-scan"></div>' +
                                '<i class="bi bi-code-slash" style="font-size:.78rem;color:var(--sl-primary);flex-shrink:0"></i>' +
                                '<span>Gerando <strong>' + codeLang + '</strong>...</span>' +
                                '<span class="sl-status-dots"><span></span><span></span><span></span></span>';
                        } else {
                            if (codeGenPill) { codeGenPill.remove(); codeGenPill = null; }
                            visibleTarget = displayText;
                        }

                        // Acrescenta só o trecho NOVO num span próprio com fade-in — nunca
                        // reescreve o que já apareceu (mesma lógica de chat.ejs/Especialista).
                        if (visibleTarget.length > renderedText.length) {
                            var novoTrecho = visibleTarget.slice(renderedText.length);
                            var chunkSpan = document.createElement('span');
                            chunkSpan.className = 'sl-chunk';
                            chunkSpan.textContent = novoTrecho;
                            textSpan.appendChild(chunkSpan);
                            renderedText = visibleTarget;
                        } else if (visibleTarget.length < renderedText.length) {
                            textSpan.textContent = visibleTarget;
                            renderedText = visibleTarget;
                        }
                        chatWrap.scrollTop = chatWrap.scrollHeight;

                    } else if (event.type === 'code_patch') {
                        pendingPatch = event;

                    } else if (event.type === 'done') {
                        const stepCount = statusHistory.length;
                        hideStatus();
                        if (cursor) cursor.remove();
                        codeGenPill = null;
                        var finalReply = event.reply || streamText;
                        var tmIdx = finalReply.indexOf('[[TEMPLATE:');
                        if (tmIdx !== -1) finalReply = finalReply.slice(0, tmIdx).trim();
                        if (bubble && streamContent) {
                            streamContent.innerHTML = renderMarkdown(finalReply);
                            mountMermaid(streamContent);
                            appendMsgFooter(bubble, finalReply, stepCount);
                        } else if (bubble) {
                            bubble.innerHTML = renderMarkdown(finalReply);
                            mountMermaid(bubble);
                        } else {
                            addBubble('assistant', finalReply);
                            appendMsgFooter(chatWrap.lastElementChild, finalReply, stepCount);
                        }
                        if (pendingPatch) {
                            var msgRow = bubble || chatWrap.lastElementChild;
                            var firstBlock = msgRow && msgRow.querySelector('.sl-code-block');
                            if (firstBlock) {
                                var fixBadge = document.createElement('div');
                                fixBadge.className = 'sl-code-fix-badge';
                                fixBadge.innerHTML =
                                    '<i class="bi bi-check2-circle"></i>' +
                                    '<span>Código corrigido automaticamente</span>' +
                                    (pendingPatch.lang ? '<span class="sl-code-fix-lang">' + pendingPatch.lang + '</span>' : '');
                                firstBlock.insertBefore(fixBadge, firstBlock.firstChild);
                                setTimeout(function () {
                                    fixBadge.classList.add('sl-code-fix-badge--out');
                                    setTimeout(function () { if (fixBadge.parentNode) fixBadge.parentNode.removeChild(fixBadge); }, 500);
                                }, 5000);
                            }
                            pendingPatch = null;
                        }
                        // Sem botão de download avulso aqui — o chat do Workspace
                        // não envia downloadUrl no evento "done" (server-side,
                        // workspaceChat.js). Toda versão gerada/editada já fica
                        // disponível pra baixar na aba Histórico de Versões.
                        //
                        // event.preview (presente só quando uma edição foi
                        // aplicada de verdade neste turno) ganha um botão "Ver
                        // alteração aplicada" — não é download, é preview visual
                        // (mesmo endpoint do "Ver Demo" da tela principal).
                        if (event.preview) {
                            var previewRow = bubble || chatWrap.lastElementChild;
                            if (previewRow) {
                                var previewBtn = document.createElement('button');
                                previewBtn.type = 'button';
                                previewBtn.className = 'sl-chat-preview-btn';
                                previewBtn.innerHTML = '<i class="bi bi-eye-fill"></i><span>Ver alteração aplicada</span>';
                                previewBtn.style.cssText = 'margin-top:8px;display:inline-flex;align-items:center;gap:6px;' +
                                    'padding:6px 14px;border-radius:20px;border:1px solid var(--sl-primary);' +
                                    'background:transparent;color:var(--sl-primary);font-size:.78rem;font-weight:700;cursor:pointer';
                                previewBtn.onclick = function () { slVerAlteracaoAplicada(event.preview); };
                                previewRow.appendChild(previewBtn);
                            }
                        }
                        chatWrap.scrollTop = chatWrap.scrollHeight;
                        conversationHistory.push({ role: 'assistant', content: finalReply });
                        if (event.sessionId) currentSessionId = event.sessionId;
                        if (event.tokens) debitarContadorUI(event.tokens);
                        break outer;

                    } else if (event.type === 'error') {
                        hideStatus();
                        conversationHistory.pop();
                        const errMsg = '⚠️ ' + (event.message || 'Erro ao processar.');
                        if (bubble && streamContent) { if (cursor) cursor.remove(); streamContent.innerHTML = renderMarkdown(errMsg); mountMermaid(streamContent); }
                        else if (bubble) { if (cursor) cursor.remove(); bubble.innerHTML = renderMarkdown(errMsg); mountMermaid(bubble); }
                        else addBubble('assistant', errMsg);
                        break outer;
                    }
                }
            }

        } catch (err) {
            hideStatus();
            if (err && err.name === 'AbortError') {
                // Parado pelo usuário — finaliza com o que já foi gerado, sem
                // tratar como erro. Se nada chegou a ser gerado, desfaz o
                // turno (como se a mensagem não tivesse sido enviada).
                if (cursor) cursor.remove();
                if (codeGenPill) { codeGenPill.remove(); codeGenPill = null; }
                var textoParcial = streamText.replace(/\[\[TEMPLATE:[\s\S]*$/, '').trim();
                if (textoParcial) {
                    if (bubble && streamContent) { streamContent.innerHTML = renderMarkdown(textoParcial); mountMermaid(streamContent); appendMsgFooter(bubble, textoParcial, statusHistory.length); }
                    else if (bubble) { bubble.innerHTML = renderMarkdown(textoParcial); mountMermaid(bubble); }
                    conversationHistory.push({ role: 'assistant', content: textoParcial });
                } else {
                    conversationHistory.pop();
                    if (bubble) bubble.remove();
                }
            } else {
                conversationHistory.pop();
                const errMsg = 'Falha de conexão. Verifique sua internet e tente novamente.';
                if (bubble && streamContent) { if (cursor) cursor.remove(); streamContent.innerHTML = renderMarkdown(errMsg); mountMermaid(streamContent); }
                else if (bubble) { if (cursor) cursor.remove(); bubble.innerHTML = renderMarkdown(errMsg); mountMermaid(bubble); }
                else addBubble('assistant', errMsg);

                const retryWrap = document.createElement('div');
                retryWrap.className = 'mt-2';
                const retryBtn = document.createElement('button');
                retryBtn.type = 'button';
                retryBtn.className = 'btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1';
                retryBtn.innerHTML = '<i class="bi bi-arrow-clockwise"></i> Tentar novamente';
                retryBtn.addEventListener('click', function () {
                    chatInput.value = msg;
                    resizeInput();
                    slChatSend();
                });
                retryWrap.appendChild(retryBtn);
                (bubble || chatWrap.lastElementChild).appendChild(retryWrap);
            }
        } finally {
            currentAbortController = null;
            setLoading(false);
            chatSend.disabled = chatInput.value.trim().length === 0;
        }
    }

    // ── Histórico de conversas ────────────────────────────────────────────
    window.slHistoricoOpen = function () {
        document.getElementById('sl-hist-overlay').style.display = 'block';
        document.getElementById('sl-hist-drawer').style.transform = 'translateX(0)';
        slHistoricoLoad();
    };

    window.slHistoricoClose = function () {
        document.getElementById('sl-hist-overlay').style.display = 'none';
        document.getElementById('sl-hist-drawer').style.transform = 'translateX(-100%)';
    };

    async function slHistoricoLoad() {
        var list = document.getElementById('sl-hist-list');
        list.innerHTML = '<p style="padding:14px 12px;color:var(--sl-text-400);font-size:.82rem">Carregando...</p>';
        try {
            var r = await fetch('/api/chat/sessions?type=' + HIST_TYPE);
            var d = await r.json();
            var sessions = d.sessions || [];
            if (!sessions.length) {
                list.innerHTML = '<p style="padding:14px 12px;color:var(--sl-text-400);font-size:.82rem">Nenhuma conversa salva ainda.</p>';
                return;
            }
            list.innerHTML = sessions.map(function (s) {
                var dt = new Date(s.updatedAt);
                var dateStr = dt.toLocaleDateString('pt-BR', { day: '2-digit', month: 'short' }) +
                              ' ' + dt.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' });
                var preview = (s.firstMessage || '(sem mensagem)').slice(0, 72);
                return '<div class="sl-hist-item" onclick="slHistoricoCarregar(\'' + s.sessionId + '\')">' +
                    '<div class="sl-hist-preview">' + preview + '</div>' +
                    '<div class="sl-hist-meta"><span>' + dateStr + '</span><span>' + (s.messageCount || 0) + ' msgs</span></div>' +
                '</div>';
            }).join('');
        } catch (e) {
            list.innerHTML = '<p style="padding:14px 12px;color:#f87171;font-size:.82rem">Erro ao carregar histórico.</p>';
        }
    }

    window.slHistoricoCarregar = async function (sessionId) {
        if (isLoading) return;
        var list = document.getElementById('sl-hist-list');
        list.innerHTML = '<p style="padding:14px 12px;color:var(--sl-text-400);font-size:.82rem">Carregando conversa...</p>';
        try {
            var r = await fetch('/api/chat/sessions/' + sessionId + '?type=' + HIST_TYPE);
            if (!r.ok) throw new Error('not found');
            var d = await r.json();
            var session = d.session;

            slChatNovo();
            currentSessionId = session.sessionId;
            (session.messages || []).forEach(function (msg) {
                if (msg.role !== 'user' && msg.role !== 'assistant') return;
                conversationHistory.push({ role: msg.role, content: msg.content });
                addBubble(msg.role, msg.content);
            });
            if (session.messages && session.messages.length) chatNovoBtn.disabled = false;
            slHistoricoClose();
            chatInput.focus();
        } catch (e) {
            list.innerHTML = '<p style="padding:14px 12px;color:#f87171;font-size:.82rem">Erro ao carregar conversa.</p>';
        }
    };

    chatSend.addEventListener('click', function () {
        if (isLoading) pararGeracao(); else slChatSend();
    });
    chatNovoBtn.addEventListener('click', slChatNovo);
    chatInput.addEventListener('input', resizeInput);
    chatInput.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' && !e.shiftKey) {
            if ('ontouchstart' in window) return;
            e.preventDefault();
            if (!isLoading && !chatSend.disabled) slChatSend();
        }
    });

    if ('ontouchstart' in window) {
        chatInput.addEventListener('focus', function () {
            setTimeout(function () { window.scrollTo(0, 0); }, 150);
        });
        if (window.visualViewport) {
            window.visualViewport.addEventListener('resize', function () {
                window.scrollTo(0, 0);
                chatWrap.scrollTop = chatWrap.scrollHeight;
            });
        }
    }
    document.querySelectorAll('.sl-chat-suggestion').forEach(function (btn) {
        btn.addEventListener('click', function () {
            chatInput.value = btn.textContent.trim();
            resizeInput();
            chatInput.focus();
            slChatSend();
        });
    });
}());
</script>

