}
.sl-solaris-icon { color: #818cf8; display: inline-flex; align-items: center; justify-content: center; }
.sl-solaris-icon svg { width: 100%; height: 100%; }

.sl-chat-upload-btn {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    border-radius: 10px;
