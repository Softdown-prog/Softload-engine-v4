<%- include('../partials/header') %>

<main class="min-vh-100 sl-pt-nav pb-5" style="background:var(--sl-bg-900)">
    <div class="container py-5">
        <div class="mx-auto" style="max-width:560px">

            <!-- Cabeçalho -->
            <div class="text-center mb-4">
                <h1 class="fw-bold text-white" style="letter-spacing:-0.02em">Suporte Técnico</h1>
                <p class="mb-0 small" style="color:var(--sl-text-400)">Envie sua mensagem para a equipe Softload. Respondemos em até 48h.</p>
            </div>

            <!-- Alertas -->
            <% if (typeof erro !== 'undefined' && erro) { %>
            <div class="alert alert-danger d-flex align-items-center gap-2 mb-4" role="alert">
                <i class="bi bi-exclamation-circle-fill flex-shrink-0"></i>
                <span><%= erro %></span>
            </div>
            <% } %>

            <% if (typeof sucesso !== 'undefined' && sucesso) { %>
            <div class="alert alert-success d-flex align-items-center gap-2 mb-4" role="alert">
                <i class="bi bi-check-circle-fill flex-shrink-0"></i>
                <span><%= sucesso %></span>
            </div>
            <% } %>

            <!-- Card do formulário -->
            <div class="rounded-4 p-4 p-md-5" style="background:rgba(15,23,42,0.6);border:1px solid var(--sl-bg-800)">

                <form action="/contato" method="POST" id="contatoForm" novalidate>

                    <!-- Nome -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold small" for="nomeInput" style="color:var(--sl-text-300)">Nome</label>
                        <input
                            id="nomeInput"
                            type="text"
                            name="nome"
                            placeholder="Seu nome completo"
                            required
                            maxlength="80"
                            autocomplete="name"
                            class="form-control"
                            style="background:var(--sl-bg-950);border-color:var(--sl-bg-800);color:var(--sl-text-300)"
                        >
                    </div>

                    <!-- E-mail -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold small" for="emailInput" style="color:var(--sl-text-300)">E-mail</label>
                        <input
                            id="emailInput"
                            type="email"
                            name="email"
                            placeholder="seu@email.com"
                            required
                            autocomplete="email"
                            class="form-control"
                            style="background:var(--sl-bg-950);border-color:var(--sl-bg-800);color:var(--sl-text-300)"
                        >
                    </div>

                    <!-- Mensagem -->
                    <div class="mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label fw-semibold small mb-0" for="mensagemInput" style="color:var(--sl-text-300)">Mensagem</label>
                            <span id="wordCount" class="small" style="color:var(--sl-text-500)">0 / 100 palavras</span>
                        </div>
                        <textarea
                            id="mensagemInput"
                            name="mensagem"
                            placeholder="Descreva sua dúvida ou problema..."
                            required
                            rows="5"
                            class="form-control"
                            style="background:var(--sl-bg-950);border-color:var(--sl-bg-800);color:var(--sl-text-300);resize:none"
                        ></textarea>
                        <div class="form-text" style="color:var(--sl-text-500)">Caracteres permitidos: letras, números e "?" &mdash; máx. 100 palavras</div>
                    </div>

                    <button type="submit" id="submitBtn" class="btn btn-sl-primary w-100">
                        Enviar Mensagem
                    </button>

                </form>

            </div>

            <!-- Aviso de rate limit -->
            <p class="text-center mt-3 small" style="color:var(--sl-text-500)">
                Limite: 1 mensagem por minuto.
            </p>

        </div>
    </div>
</main>

<script>
(function () {
    const mensagemInput = document.getElementById('mensagemInput');
    const wordCountEl   = document.getElementById('wordCount');
    const form          = document.getElementById('contatoForm');
    const REGEX_OK      = /^[a-zA-ZÀ-ÿ0-9\s?]*$/;
    const MAX_PALAVRAS  = 100;

    function contarPalavras(texto) {
        return texto.trim().split(/\s+/).filter(p => p.length > 0).length;
    }

    function atualizarContador() {
        const count = contarPalavras(mensagemInput.value);
        wordCountEl.textContent = `${count} / ${MAX_PALAVRAS} palavras`;
        if (count >= MAX_PALAVRAS) {
            wordCountEl.style.color = '#f87171';
        } else {
            wordCountEl.style.color = 'var(--sl-text-500)';
        }
    }

    // Bloquear caracteres especiais em tempo real (exceto "?")
    mensagemInput.addEventListener('input', function () {
        if (!REGEX_OK.test(this.value)) {
            this.value = this.value.replace(/[^a-zA-ZÀ-ÿ0-9\s?]/g, '');
        }

        // Truncar no limite de 100 palavras enquanto digita
        const palavras = this.value.trim().split(/\s+/).filter(p => p.length > 0);
        if (palavras.length > MAX_PALAVRAS) {
            this.value = palavras.slice(0, MAX_PALAVRAS).join(' ');
        }

        atualizarContador();
    });

    // Validação final antes de enviar
    form.addEventListener('submit', function (e) {
        const mensagem = mensagemInput.value.trim();

        if (!REGEX_OK.test(mensagem)) {
            e.preventDefault();
            alert('A mensagem contém caracteres não permitidos.');
            return;
        }

        if (contarPalavras(mensagem) > MAX_PALAVRAS) {
            e.preventDefault();
            alert('A mensagem deve ter no máximo 100 palavras.');
        }
    });
})();
</script>

<%- include('../partials/footer') %>
