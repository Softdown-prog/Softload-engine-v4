{
  "solaris-code-sandbox-production-architecture": {
    "objective": "Operar sandbox segura, eficiente e integrada ao Gemini Function Calling dentro do Google Cloud Run.",
    "core-pillars": [
      {
        "id": "workspace-ephemeral-isolation",
        "name": "isolamento-de-sessoes-por-requisicao",
        "purpose": "Garantir que cada usuário e pipeline execute em um ambiente temporário isolado.",
        "cloud-run-context": {
          "risk": "Múltiplas requisições podem atingir a mesma instância do container.",
          "rule": "Nunca utilizar diretórios temporários compartilhados sem isolamento."
        },
        "implementation": {
          "component": "SessionManager",
          "file": "src/solaris/sandbox/sessionManager.js",
          "storage": {
            "base-directory": "/tmp/sandbox",
            "type": "temporary-memory-filesystem"
          },
          "session-model": {
            "identifier": "uuid",
            "directory-format": "session-{uuid}",
            "example": "/tmp/sandbox/session-a8f2..."
          }
        },
        "lifecycle": {
          "create": [
            "gerar UUID único",
            "criar diretório isolado",
            "retornar sessionId e sessionPath"
          ],
          "cleanup": [
            "executar após finalização do pipeline",
            "remover diretório recursivamente",
            "liberar memória RAM"
          ]
        },
        "security-benefits": [
          "impede vazamento entre projetos",
          "facilita auditoria",
          "permite limpeza automática"
        ]
      },

      {
        "id": "path-security",
        "name": "protecao-contra-path-traversal",
        "purpose": "Impedir que arquivos escapem do workspace autorizado.",
        "threats": [
          "../../etc/passwd",
          "../../src/index.js",
          "acesso fora da sessão"
        ],
        "implementation": {
          "component": "PathGuard",
          "file": "src/solaris/sandbox/pathGuard.js",
          "function": "sanitizePath"
        },
        "validation-flow": [
          {
            "step": 1,
            "action": "receber-caminho-relativo",
            "example": "src/index.js"
          },
          {
            "step": 2,
            "action": "resolver-caminho-absoluto",
            "method": "path.resolve"
          },
          {
            "step": 3",
            "action": "validar-limite-da-sessao",
            "rule": "resolved-path-must-start-with-session-path"
          },
          {
            "step": 4",
            "action": "autorizar-ou-bloquear"
          }
        ],
        "security-result": {
          "allowed": "retorna caminho absoluto seguro",
          "blocked": "gera erro de segurança"
        }
      },

      {
        "id": "gemini-function-calling-integration",
        "name": "integracao-gemini-sandbox",
        "purpose": "Permitir que Gemini controle ações através de ferramentas sem acesso direto ao sistema.",
        "architecture": {
          "gemini-role": "planejador",
          "backend-role": "executor",
          "sandbox-role": "ambiente-controlado"
        },
        "flow": [
          "usuário envia intenção",
          "Gemini gera Tool Call JSON",
          "Orquestrador recebe chamada",
          "Sandbox executa operação",
          "resultado retorna ao Gemini"
        ],
        "tools": [
          {
            "name": "create_file",
            "description": "Cria ou substitui arquivo dentro do workspace ativo.",
            "parameters": {
              "filePath": {
                "type": "string",
                "description": "Caminho relativo do arquivo"
              },
              "content": {
                "type": "string",
                "description": "Conteúdo completo"
              }
            },
            "required": [
              "filePath",
              "content"
            ]
          },
          {
            "name": "run_validation",
            "description": "Executa validações estáticas através dos Workers.",
            "parameters": {
              "filePath": {
                "type": "string"
              },
              "fileType": {
                "type": "string",
                "supported-values": [
                  "html",
                  "css",
                  "js",
                  "php",
                  "python"
                ]
              }
            },
            "required": [
              "filePath",
              "fileType"
            ]
          }
        ],
        "tool-execution": {
          "validation-step": {
            "component": "PathGuard",
            "purpose": "garantir caminho seguro"
          },
          "execution-step": {
            "component": "WorkerExecutor",
            "purpose": "executar validação isolada"
          },
          "response-step": {
            "format": "gemini-tool-output",
            "contains": [
              "stdout",
              "stderr",
              "validation-result"
            ]
          }
        }
      },

      {
        "id": "cloud-run-runtime-optimization",
        "name": "ajustes-infraestrutura-cloud-run",
        "purpose": "Garantir estabilidade, performance e baixo consumo."
      }
    ],

    "cloud-run-specific-rules": {
      "temporary-storage": {
        "path": "/tmp",
        "technology": "tmpfs",
        "behavior": "armazenamento em memória RAM",
        "risk": {
          "name": "out-of-memory",
          "cause": "arquivos temporários não removidos"
        },
        "required-action": {
          "component": "SessionManager.cleanupSession",
          "execution": "finally-block"
        }
      },

      "container-concurrency": {
        "problem": "Múltiplas execuções pesadas simultâneas podem consumir recursos.",
        "recommended": {
          "requests-per-instance": {
            "minimum": 10,
            "maximum": 20
          }
        },
        "reason": [
          "reduzir competição por CPU",
          "evitar travamentos de compiladores",
          "controlar uso de RAM"
        ]
      },

      "resources": {
        "recommended-minimum": {
          "memory": "2GB",
          "cpu": "2vCPU"
        },
        "reason": [
          "parsers de código",
          "validações",
          "processamento de projetos maiores"
        ]
      },

      "http-timeout": {
        "default-risk": "requisições longas podem ser encerradas",
        "recommended": {
          "timeout": "300s",
          "description": "5 minutos para pipelines complexos"
        }
      }
    }
  },

  "sandbox-execution-pipeline": {
    "steps": [
      {
        "step": 1,
        "action": "create-session",
        "component": "SessionManager"
      },
      {
        "step": 2,
        "action": "receive-gemini-tool-call"
      },
      {
        "step": 3,
        "action": "sanitize-file-path",
        "component": "PathGuard"
      },
      {
        "step": 4,
        "action": "execute-worker",
        "environment": "isolated-session"
      },
      {
        "step": 5,
        "action": "return-tool-output-to-gemini"
      },
      {
        "step": 6,
        "action": "cleanup-session",
        "component": "SessionManager"
      }
    ]
  },

  "recommended-next-modules": {
    "priority-order": [
      {
        "module": "sessionManager-api-integration",
        "description": "Integrar criação e destruição de sessões nas rotas do Solaris API."
      },
      {
        "module": "pathGuard-middleware",
        "description": "Transformar validação de caminho em middleware global."
      },
      {
        "module": "validation-manifests",
        "description": "Criar manifestos declarativos para Workers de HTML, CSS, JS, PHP e Python."
      }
    ]
  }
}
